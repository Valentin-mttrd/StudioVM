---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import Pebble from '@/components/ui/Pebble.astro';
import { business } from '@/data/business';
import { nav } from '@/data/nav';
---

<Base title="Page introuvable · L’atypique, institut de beauté à Lorient" noindex>
  <section class="lost section">
    <div class="container lost__grid">
      <div class="lost__matter" aria-hidden="true">
        <Pebble tone="argile" size="clamp(8rem, 5rem + 10vw, 15rem)" shape={2} breathe />
        <Pebble tone="cire" size="clamp(5rem, 3rem + 5vw, 8rem)" shape={3} breathe style="--breathe-delay:-3s" />
      </div>
      <div class="lost__copy">
        <p class="label label--rule lost__eyebrow">Erreur 404</p>
        <h1 class="display h1">Cette page <em>s’est égarée.</em></h1>
        <p class="lead">L’adresse a peut-être changé. Voici de quoi retrouver votre chemin :</p>
        <ul class="lost__links" role="list">
          <li><a class="link" href="/">Accueil</a></li>
          {nav.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        </ul>
        <Button href={business.booking.url} external>Prendre rendez-vous</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost__grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-8);
  }
  .lost__matter {
    display: flex;
    align-items: flex-end;
  }
  .lost__matter :global(.pebble + .pebble) {
    margin-left: -2rem;
  }
  .lost__copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .lost__eyebrow {
    color: var(--c-argile);
  }
  .lost__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  @media (max-width: 47.99rem) {
    .lost__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }
</style>
