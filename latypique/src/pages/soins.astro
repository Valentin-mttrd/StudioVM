---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/shared/PageHeader.astro';
import Visit from '@/components/shared/Visit.astro';
import Button from '@/components/ui/Button.astro';
import Pebble from '@/components/ui/Pebble.astro';
import Icon from '@/components/ui/Icon.astro';
import { soins } from '@/data/soins';
import { business } from '@/data/business';
import { breadcrumbSchema } from '@/lib/seo';

const crumbs = breadcrumbSchema(
  [
    { name: 'Accueil', path: '/' },
    { name: 'Soins', path: '/soins' },
  ],
  Astro.site,
);
---

<Base
  title="Carte des soins · Institut de beauté à Lorient · L’atypique"
  description="Soins visage et corps 100 % naturels, minceur, épilation à la cire végétale, manucure et semi-permanent manioc & maïs, pédi-spa, maquillage, UV à Lorient."
  structuredData={[crumbs]}
>
  <PageHeader
    crumb="Soins"
    eyebrow="Institut de beauté slow cosmétique · Lorient"
    title="La carte des soins,"
    accent="de la tête aux pieds."
    lead="Une large gamme de soins du visage, du corps, des mains et des pieds, de soins minceur, d’épilation et de maquillage — adaptés à vos envies et à vos besoins."
    tones={['sauge', 'cire']}
  >
    <div class="soins-intro__ctas">
      <Button href={business.booking.url} external>Prendre rendez-vous</Button>
      <p class="soins-intro__note">
        <Icon name="calendar" />
        <span>Tarifs, durées et disponibilités de chaque prestation&nbsp;: sur l’agenda en ligne, au moment de réserver.</span>
      </p>
    </div>
  </PageHeader>

  <nav class="chips" aria-label="Familles de soins" data-chips>
    <div class="container">
      <ul class="chips__list" role="list">
        {
          soins.map((family) => (
            <li>
              <a class="chips__chip" href={`#${family.id}`} data-chip={family.id}>
                <span class="chips__dot" style={`background:var(--p-${family.tone})`} aria-hidden="true" />
                {family.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="families">
    {
      soins.map((family, i) => (
        <section class="family" id={family.id} aria-labelledby={`${family.id}-title`} data-family>
          <div class="container family__grid">
            <div class="family__aside" aria-hidden="true">
              <div class="family__sticky">
                <span class="family__num num">{String(i + 1).padStart(2, '0')}</span>
                <Pebble tone={family.tone} size="clamp(6rem, 3rem + 9vw, 12rem)" shape={((i % 4) + 1) as 1 | 2 | 3 | 4} breathe />
              </div>
            </div>

            <div class="family__body">
              <header class="family__head" data-reveal>
                <p class="family__num-inline num" aria-hidden="true">
                  N°{String(i + 1).padStart(2, '0')}
                </p>
                <h2 class="display family__title" id={`${family.id}-title`}>
                  {family.name}
                </h2>
                {family.composition && (
                  <p class="family__composition">
                    <span class="label">Composition</span>
                    <span>{family.composition}</span>
                  </p>
                )}
              </header>

              <p class="family__desc" data-reveal>
                {family.description}
              </p>

              {family.covers.length > 1 && (
                <ul class="family__covers" role="list" aria-label="Au programme" data-reveal>
                  {family.covers.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              )}

              {family.prestations.length > 0 ? (
                <table class="prices" data-reveal>
                  <caption class="sr-only">Prestations et tarifs — {family.name}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Prestation</th>
                      <th scope="col">Durée</th>
                      <th scope="col">Tarif</th>
                    </tr>
                  </thead>
                  <tbody>
                    {family.prestations.map((p) => (
                      <tr>
                        <th scope="row">
                          {p.name}
                          {p.description && <span class="prices__desc">{p.description}</span>}
                        </th>
                        <td>{p.duration ?? '—'}</td>
                        <td>{p.price ?? '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : null}

              <div class="family__actions" data-reveal>
                <Button href={business.booking.url} external size="small">
                  Réserver ce soin<span class="sr-only"> : {family.name}</span>
                </Button>
                <p class="family__ask">
                  Une question&nbsp;? <a href={business.phone.href}>{business.phone.display}</a>
                </p>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <Visit title="Votre soin," accent="en quelques clics." />
</Base>

<script>
  /* Highlight the chip of the family in view, and keep it scrolled into
     the chip bar on phones. */
  const chips = document.querySelector<HTMLElement>('[data-chips]');
  if (chips && 'IntersectionObserver' in window) {
    const links = new Map(
      [...chips.querySelectorAll<HTMLAnchorElement>('[data-chip]')].map((a) => [a.dataset.chip, a]),
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          const active = links.get(entry.target.id);
          if (!active) continue;
          active.setAttribute('aria-current', 'true');
          const list = active.closest('ul');
          if (list && list.scrollWidth > list.clientWidth) {
            list.scrollTo({
              left: active.offsetLeft - list.clientWidth / 2 + active.offsetWidth / 2,
              behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            });
          }
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    document.querySelectorAll('[data-family]').forEach((section) => observer.observe(section));
  }
</script>

<style>
  .soins-intro__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
    margin-top: var(--s-2);
  }
  .soins-intro__note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    max-width: 24rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--c-ecorce-doux);
  }
  .soins-intro__note :global(.icon) {
    margin-top: 0.1rem;
    color: var(--c-argile);
  }

  /* --- Sticky chip bar ---------------------------------------------- */
  .chips {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: var(--s-3);
    background: rgb(242 236 227 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-block: 1px solid var(--line);
  }
  /* Sit under the header while it's shown. */
  :global(.header:not([data-hidden])) ~ main .chips {
    top: var(--header-h);
    transition: top 600ms var(--ease-settle);
  }
  .chips__list {
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px;
    margin: -2px;
  }
  .chips__list::-webkit-scrollbar {
    display: none;
  }
  .chips__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--d-base) var(--ease-settle),
      color var(--d-base) var(--ease-settle),
      border-color var(--d-base) var(--ease-settle);
  }
  .chips__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(42 34 28 / 0.15);
  }
  .chips__chip[aria-current] {
    background: var(--c-ecorce);
    border-color: var(--c-ecorce);
    color: var(--c-creme);
  }
  @media (hover: hover) {
    .chips__chip:not([aria-current]):hover {
      border-color: var(--c-ecorce);
    }
  }

  /* --- Families ------------------------------------------------------ */
  .family {
    padding-block: var(--s-8);
    scroll-margin-top: calc(var(--header-h) + 4.5rem);
  }
  .family + .family {
    border-top: 1px solid var(--line);
  }
  .family:nth-child(even) {
    background: color-mix(in oklab, var(--c-lait) 70%, var(--c-lin));
  }
  .family__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--s-7);
  }
  .family__sticky {
    position: sticky;
    top: calc(var(--header-h) + 6rem);
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }
  .family__num {
    font-size: clamp(4rem, 2.5rem + 5vw, 7.5rem);
    line-height: 0.8;
    color: var(--c-argile);
    font-weight: 300;
  }
  .family__num-inline {
    display: none;
    color: var(--c-argile);
  }
  .family__body {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    max-width: 44rem;
  }
  .family__head {
    display: grid;
    gap: var(--s-4);
  }
  .family__title {
    font-size: var(--t-h2);
    font-weight: 330;
    letter-spacing: -0.03em;
  }
  .family__composition {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    padding: 0.7rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-s);
    justify-self: start;
    font-weight: 500;
  }
  .family__composition .label {
    color: var(--c-argile);
  }
  .family__desc {
    font-size: var(--t-lead);
    line-height: 1.55;
  }
  .family__covers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .family__covers li {
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-pill);
    background: var(--c-sable);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .family__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-2);
  }
  .family__ask {
    font-size: 0.92rem;
    color: var(--c-ecorce-doux);
  }
  .family__ask a {
    color: var(--c-argile);
    font-weight: 600;
    white-space: nowrap;
  }

  .prices {
    width: 100%;
    border-collapse: collapse;
  }
  .prices th,
  .prices td {
    padding: 0.85rem 0;
    border-bottom: 1px dashed var(--line-strong);
    text-align: left;
    vertical-align: top;
  }
  .prices thead th {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ecorce-doux);
    border-bottom-style: solid;
  }
  .prices tbody th {
    font-weight: 500;
  }
  .prices td {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    padding-left: var(--s-4);
  }
  .prices thead th:not(:first-child) {
    text-align: right;
  }
  .prices__desc {
    display: block;
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--c-ecorce-doux);
  }

  @media (max-width: 55.99rem) {
    .family__grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .family__aside {
      display: none;
    }
    .family__num-inline {
      display: block;
    }
  }
</style>
