---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/shared/PageHeader.astro';
import Visit from '@/components/shared/Visit.astro';
import Photo from '@/components/ui/Photo.astro';
import Pebble from '@/components/ui/Pebble.astro';
import Icon from '@/components/ui/Icon.astro';
import Stars from '@/components/ui/Stars.astro';
import Button from '@/components/ui/Button.astro';
import { engagements } from '@/data/soins';
import { business, mapLinks } from '@/data/business';
import { breadcrumbSchema } from '@/lib/seo';

const crumbs = breadcrumbSchema(
  [
    { name: 'Accueil', path: '/' },
    { name: 'L’institut', path: '/institut' },
  ],
  Astro.site,
);
const rating = business.rating.value.toLocaleString('fr-FR');
---

<Base
  title="L’institut · Slow cosmétique à Lorient · L’atypique"
  description="L’atypique, institut de beauté slow cosmétique à Lorient : produits 100 % naturels, espace rénové, deux cabines de soins, cabine UV et parking facile."
  structuredData={[crumbs]}
>
  <PageHeader
    crumb="L’institut"
    eyebrow="L’institut"
    title="Un institut de beauté"
    accent="pas tout à fait comme les autres."
    lead="L’atypique vous accueille à Lorient dans un cadre chaleureux, pour vous offrir un moment unique dédié à votre bien-être."
    tones={['argile', 'sauge']}
  />

  <!-- 1. Slow cosmétique -->
  <section class="slow section" aria-labelledby="slow-title">
    <div class="container slow__grid">
      <div class="slow__intro">
        <p class="label label--rule slow__eyebrow">La slow cosmétique</p>
        <h2 class="display h2" id="slow-title" data-reveal>
          Prendre soin de vous, <em>autrement.</em>
        </h2>
        <p class="lead" data-reveal>
          Le mouvement slow cosmétique défend une beauté plus naturelle et plus raisonnée. À L’atypique, cette
          démarche se traduit par trois choix concrets, visibles dans chaque soin.
        </p>
      </div>

      <ol class="slow__list" role="list" data-reveal-group>
        {
          engagements.map((item, i) => (
            <li class="slow__item" data-reveal>
              <Pebble tone={item.tone} size="5.5rem" shape={((i % 3) + 1) as 1 | 2 | 3} />
              <div>
                <p class="num slow__num">N°{item.number}</p>
                <h3 class="display slow__title">{item.title}</h3>
                <p class="muted">{item.text}</p>
                <a class="link slow__link" href={item.link.href}>
                  {item.link.label}
                  <Icon name="arrow" class="btn__icon" />
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 2. L'espace -->
  <section class="space section on-dark" aria-labelledby="space-title">
    <div class="container">
      <div class="space__head">
        <p class="label label--rule space__eyebrow">L’espace</p>
        <h2 class="display h2" id="space-title" data-reveal>
          Un lieu <em>récemment rénové</em>, pensé pour votre bien-être.
        </h2>
        <p class="lead" data-reveal>
          Bien-être et détente y sont les maîtres-mots : deux cabines de soins modernisées, une cabine UV, dans un
          cadre chaleureux.
        </p>
      </div>

      <div class="space__gallery" data-reveal-group>
        <div class="space__cell space__cell--a" data-reveal>
          <Photo alt="" label="La façade, rue du Général Dubail" ratio="3 / 4" tone="lin" shape="arch" />
        </div>
        <div class="space__cell space__cell--b" data-reveal>
          <Photo alt="" label="Cabine de soins n°1" ratio="4 / 3" tone="argile" />
        </div>
        <div class="space__cell space__cell--c" data-reveal>
          <Photo alt="" label="Cabine de soins n°2" ratio="4 / 3" tone="sauge" />
        </div>
        <div class="space__cell space__cell--d" data-reveal>
          <Photo alt="" label="La cabine UV" ratio="1 / 1" tone="soleil" />
        </div>
      </div>

      <dl class="space__facts" data-reveal-group>
        <div data-reveal>
          <dt class="display">{business.facilities.treatmentRooms}</dt>
          <dd><strong>cabines de soins</strong> modernisées</dd>
        </div>
        <div data-reveal>
          <dt class="display">1</dt>
          <dd><strong>cabine UV</strong></dd>
        </div>
        <div data-reveal>
          <dt><Icon name="car" class="space__icon" /></dt>
          <dd><strong>Parking</strong> facile d’accès, pour votre confort dès l’arrivée</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 3. L'équipe -->
  <section class="team section" aria-labelledby="team-title">
    <div class="container team__grid">
      <div data-reveal>
        <Photo alt="" label="L’équipe de l’institut" ratio="4 / 5" tone="rose" shape="arch" />
      </div>
      <div class="team__copy">
        <p class="label label--rule team__eyebrow">L’équipe</p>
        <h2 class="display h2" id="team-title" data-reveal>
          Expertise technique <em>et écoute.</em>
        </h2>
        <p class="lead" data-reveal>
          Une équipe attentionnée veille à vous garantir une expérience de qualité, avec des soins adaptés à vos envies
          et à vos besoins — pour vous sentir mieux dans votre peau.
        </p>

        <a class="team__rating" href={mapLinks.reviews} target="_blank" rel="noopener" data-reveal>
          <span class="team__score display">{rating}<small>/5</small></span>
          <span class="team__rating-meta">
            <Stars value={business.rating.value} />
            <span>Note moyenne, {business.rating.countLabel} clients en ligne</span>
          </span>
          <span class="sr-only">— lire les avis (nouvel onglet)</span>
          <Icon name="external" class="team__rating-icon" />
        </a>

        <div class="team__social" data-reveal>
          <p class="muted">L’actualité de l’institut, au fil des jours&nbsp;:</p>
          <div class="team__social-links">
            <Button href={business.links.instagram} variant="ghost" leadingIcon="instagram" external size="small">
              {business.links.instagramHandle}
            </Button>
            <Button href={business.links.facebook} variant="ghost" leadingIcon="facebook" external size="small">
              Facebook
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Visit title="Venez vivre" accent="le moment L’atypique." />
</Base>

<style>
  /* --- Slow cosmétique ---------------------------------------------- */
  .slow__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--s-8);
    align-items: start;
  }
  .slow__intro {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: var(--s-5);
  }
  .slow__eyebrow {
    color: var(--c-argile);
  }
  .slow__list {
    display: grid;
  }
  .slow__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line-strong);
  }
  .slow__item > div {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .slow__num {
    color: var(--c-argile);
  }
  .slow__title {
    font-size: var(--t-h3);
    font-weight: 360;
  }
  .slow__link {
    color: var(--c-argile);
    font-size: 0.95rem;
  }

  /* --- L'espace ------------------------------------------------------ */
  .space__head {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
    margin-bottom: var(--s-7);
  }
  .space__eyebrow {
    color: var(--c-mais-vif);
  }
  .space__gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-4);
    align-items: start;
  }
  .space__cell--a {
    grid-column: 1 / 5;
    grid-row: 1 / 3;
  }
  .space__cell--b {
    grid-column: 5 / 10;
  }
  .space__cell--c {
    grid-column: 5 / 10;
  }
  .space__cell--d {
    grid-column: 10 / 13;
    grid-row: 1;
    margin-top: var(--s-8);
  }
  .space__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--s-7);
    border-top: 1px solid var(--line-on-dark);
  }
  .space__facts > div {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-5) 0 0;
  }
  .space__facts > div + div {
    padding-left: var(--s-5);
    border-left: 1px solid var(--line-on-dark);
  }
  .space__facts dt {
    font-size: clamp(2.6rem, 2rem + 2vw, 4rem);
    font-weight: 300;
    line-height: 1;
    color: var(--c-mais-vif);
    min-height: 1em;
  }
  .space__facts dd {
    color: var(--c-creme-doux);
  }
  .space__facts strong {
    color: var(--c-creme);
    font-weight: 600;
  }
  :global(.space__icon) {
    width: 1em !important;
    height: 1em !important;
    stroke-width: 1 !important;
  }

  /* --- L'équipe ------------------------------------------------------ */
  .team__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .team__copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .team__eyebrow {
    color: var(--c-argile);
  }
  .team__rating {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    width: 100%;
    max-width: 30rem;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    background: var(--c-lait);
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--d-base) var(--ease-settle),
      box-shadow var(--d-base) var(--ease-settle);
  }
  @media (hover: hover) {
    .team__rating:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }
  }
  .team__score {
    font-size: 2.75rem;
    font-weight: 330;
    line-height: 1;
  }
  .team__score small {
    font-size: 0.45em;
    color: var(--c-ecorce-doux);
  }
  .team__rating-meta {
    display: grid;
    gap: 0.25rem;
    font-size: 0.88rem;
    color: var(--c-ecorce-doux);
  }
  :global(.team__rating-icon) {
    margin-left: auto;
    color: var(--c-argile);
  }
  .team__social {
    display: grid;
    gap: var(--s-3);
  }
  .team__social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  @media (max-width: 63.99rem) {
    .slow__grid,
    .team__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .slow__intro {
      position: static;
    }
    .space__cell--a {
      grid-column: 1 / 7;
    }
    .space__cell--b,
    .space__cell--c {
      grid-column: 7 / 13;
    }
    .space__cell--d {
      grid-column: 1 / 7;
      grid-row: auto;
      margin-top: 0;
    }
  }
  @media (max-width: 47.99rem) {
    .space__gallery {
      grid-template-columns: 1fr 1fr;
    }
    .space__cell--a {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .space__cell--b,
    .space__cell--c,
    .space__cell--d {
      grid-column: auto;
    }
    .space__facts {
      grid-template-columns: 1fr;
    }
    .space__facts > div,
    .space__facts > div + div {
      grid-template-columns: 4.5rem 1fr;
      align-items: center;
      padding: var(--s-4) 0;
      border-left: 0;
      border-bottom: 1px solid var(--line-on-dark);
    }
    .slow__item {
      grid-template-columns: 1fr;
    }
  }
</style>
