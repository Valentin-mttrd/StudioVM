---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/shared/PageHeader.astro';
import { business } from '@/data/business';
const { legal } = business;
---

<Base
  title="Mentions légales · L’atypique, institut de beauté à Lorient"
  description="Mentions légales du site de L’atypique, institut de beauté slow cosmétique à Lorient."
  noindex
>
  <PageHeader crumb="Mentions légales" eyebrow="Informations légales" title="Mentions légales" tones={['lin', 'sauge']} />

  <section class="section--tight legal">
    <div class="container prose">
      <h2>Éditeur du site</h2>
      <p>
        <strong>{business.legalName}</strong> — {legal.form} au capital de {legal.capital}<br />
        Siège social : {business.address.street}, {business.address.postalCode} {business.address.city}<br />
        {legal.rcs} — SIRET {legal.siret}<br />
        Code APE : {legal.ape}<br />
        Téléphone : <a href={business.phone.href}>{business.phone.display}</a><br />
        E-mail : {business.email ? <a href={`mailto:${business.email}`}>{business.email}</a> : <span class="todo">[adresse e-mail à compléter]</span>}
      </p>

      <h2>Directrice de la publication</h2>
      <p>{legal.manager}, gérante.</p>

      <h2>Hébergement</h2>
      <p>
        Ce site est hébergé par <span class="todo">[nom de l’hébergeur à compléter]</span>,
        <span class="todo">[adresse de l’hébergeur à compléter]</span>.
      </p>

      <h2>Conception et réalisation</h2>
      <p>
        Studio VM — <a href="https://www.studiovm-design.fr" target="_blank" rel="noopener">studiovm-design.fr</a>.
      </p>

      <h2>Réservation en ligne</h2>
      <p>
        La prise de rendez-vous en ligne est assurée par la plateforme {business.booking.provider}, accessible depuis
        les boutons « Prendre rendez-vous » du site. Les conditions d’utilisation de ce service sont consultables sur
        la plateforme.
      </p>

      <h2>Médiation de la consommation</h2>
      <p>
        Conformément aux articles L.611-1 et suivants du Code de la consommation, tout client peut recourir
        gratuitement au médiateur de la consommation dont relève l’institut :
        <span class="todo">[nom et coordonnées du médiateur à compléter]</span>.
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L’ensemble des contenus de ce site (textes, visuels, logotype, mise en page) est la propriété de
        {business.legalName} ou de ses partenaires. Toute reproduction ou représentation, totale ou partielle, sans
        autorisation préalable est interdite.
      </p>
      <p>
        Typographies : Fraunces et Instrument Sans, distribuées sous licence SIL Open Font License 1.1.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement des données personnelles est détaillé dans la
        <a href="/confidentialite">politique de confidentialité</a>.
      </p>
    </div>
  </section>
</Base>
