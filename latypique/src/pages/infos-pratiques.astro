---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/shared/PageHeader.astro';
import HoursTable from '@/components/shared/HoursTable.astro';
import MapEmbed from '@/components/shared/MapEmbed.astro';
import Faq from '@/components/shared/Faq.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import OpenStatus from '@/components/ui/OpenStatus.astro';
import { business, mapLinks } from '@/data/business';
import { faq } from '@/data/faq';
import { breadcrumbSchema, faqSchema } from '@/lib/seo';

const crumbs = breadcrumbSchema(
  [
    { name: 'Accueil', path: '/' },
    { name: 'Infos pratiques', path: '/infos-pratiques' },
  ],
  Astro.site,
);
---

<Base
  title="Infos pratiques · Horaires, accès, contact · L’atypique Lorient"
  description="L’atypique, 14 rue du Général Dubail à Lorient : horaires, accès et parking, téléphone 09 81 94 09 93, réservation en ligne et questions fréquentes."
  structuredData={[crumbs, faqSchema(faq)]}
>
  <PageHeader
    crumb="Infos pratiques"
    eyebrow="Infos pratiques"
    title="Venir à l’institut,"
    accent="simplement."
    lead={`Au ${business.address.street}, à ${business.address.city}. Réservation en ligne ou par téléphone, parking facile d’accès.`}
    tones={['mais', 'argile']}
  />

  <section class="section--tight" aria-label="Adresse, horaires et contact">
    <div class="container cards" data-reveal-group>
      <article class="card" data-reveal aria-labelledby="card-address">
        <p class="label card__label"><Icon name="pin" /> Adresse</p>
        <h2 class="card__title display" id="card-address">
          {business.address.street}<br />{business.address.postalCode} {business.address.city}
        </h2>
        <p class="card__line"><Icon name="car" /> {business.facilities.parking}</p>
        <ul class="card__pills" role="list" aria-label="Itinéraire">
          <li><a href={mapLinks.google} target="_blank" rel="noopener">Google Maps<span class="sr-only"> (nouvel onglet)</span></a></li>
          <li><a href={mapLinks.apple} target="_blank" rel="noopener">Plans<span class="sr-only"> d’Apple (nouvel onglet)</span></a></li>
          <li><a href={mapLinks.waze} target="_blank" rel="noopener">Waze<span class="sr-only"> (nouvel onglet)</span></a></li>
        </ul>
      </article>

      <article class="card" id="horaires" data-reveal aria-labelledby="card-hours">
        <div class="card__row">
          <p class="label card__label"><Icon name="clock" /> Horaires</p>
          <OpenStatus variant="badge" />
        </div>
        <h2 class="sr-only" id="card-hours">Horaires d’ouverture</h2>
        <HoursTable />
      </article>

      <article class="card card--dark on-dark" data-reveal aria-labelledby="card-contact">
        <p class="label card__label"><Icon name="calendar" /> Rendez-vous &amp; contact</p>
        <h2 class="card__title display" id="card-contact">Réservez en ligne, <em>ou appelez-nous.</em></h2>
        <div class="card__actions">
          <Button href={business.booking.url} variant="light" external block>Prendre rendez-vous</Button>
          <Button href={business.phone.href} variant="ghost-light" leadingIcon="phone" block>{business.phone.display}</Button>
        </div>
        <ul class="card__social" role="list">
          <li>
            <a href={business.links.instagram} target="_blank" rel="noopener">
              <Icon name="instagram" /> {business.links.instagramHandle}<span class="sr-only"> sur Instagram (nouvel onglet)</span>
            </a>
          </li>
          <li>
            <a href={business.links.facebook} target="_blank" rel="noopener">
              <Icon name="facebook" /> Facebook<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
          {
            business.email && (
              <li>
                <a href={`mailto:${business.email}`}>{business.email}</a>
              </li>
            )
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="map-title">
    <div class="container">
      <h2 class="sr-only" id="map-title">Plan d’accès</h2>
      <div data-reveal>
        <MapEmbed />
      </div>
    </div>
  </section>

  <section class="section faq-section" id="questions" aria-labelledby="faq-title">
    <div class="container faq-section__grid">
      <div class="faq-section__intro">
        <p class="label label--rule faq-section__eyebrow">Questions fréquentes</p>
        <h2 class="display h2" id="faq-title" data-reveal>Tout ce qu’il faut savoir <em>avant de venir.</em></h2>
        <p class="muted" data-reveal>
          Une autre question&nbsp;? L’institut vous répond au <a href={business.phone.href}>{business.phone.display}</a>.
        </p>
      </div>
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    align-items: stretch;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    background: var(--c-lait);
    box-shadow: var(--shadow-soft);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .card--dark {
    border-color: transparent;
    background: var(--c-mousse);
  }
  .card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .card__label {
    color: var(--c-argile);
    gap: 0.5em;
  }
  .card--dark .card__label {
    color: var(--c-mais-vif);
  }
  .card__label :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .card__title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 350;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .card__line {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-ecorce-doux);
  }
  .card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: auto;
  }
  .card__pills a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--d-base) var(--ease-settle),
      color var(--d-base) var(--ease-settle);
  }
  @media (hover: hover) {
    .card__pills a:hover {
      background: var(--c-ecorce);
      color: var(--c-creme);
    }
  }
  .card__actions {
    display: grid;
    gap: var(--s-2);
  }
  .card__social {
    display: grid;
    gap: 0.25rem;
    font-size: 0.95rem;
  }
  .card__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.25rem;
    text-decoration: none;
  }
  .card__social a:hover {
    text-decoration: underline;
  }

  .faq-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: var(--s-8);
    align-items: start;
  }
  .faq-section__intro {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: var(--s-5);
  }
  .faq-section__eyebrow {
    color: var(--c-argile);
  }
  .faq-section__intro a {
    color: var(--c-argile);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 63.99rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .card--dark {
      grid-column: 1 / -1;
    }
    .faq-section__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .faq-section__intro {
      position: static;
    }
  }
  @media (max-width: 47.99rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
