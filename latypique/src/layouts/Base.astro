---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileBar from '@/components/layout/MobileBar.astro';
import { business } from '@/data/business';
import { SITE_DESCRIPTION, absoluteUrl, businessSchema } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  /** Full <title>. Keep "L'atypique" and "Lorient" in it. */
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  structuredData?: object[];
}

const { title, description = SITE_DESCRIPTION, ogImage = '/og.jpg', noindex = false, structuredData = [] } =
  Astro.props;

const site = Astro.site;
const canonical = absoluteUrl(Astro.url.pathname, site);
const schemas = [businessSchema(site), ...structuredData];
---

<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f2ece3" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href="/fonts/fraunces-roman.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(ogImage, site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="L’atypique — institut de beauté slow cosmétique à Lorient" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="FR-56" />
    <meta name="geo.placename" content={business.address.city} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
