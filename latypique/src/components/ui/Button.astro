---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'light' | 'ghost-light';
  size?: 'default' | 'small';
  icon?: IconName | null;
  /** Leading icon (e.g. phone) instead of the trailing arrow. */
  leadingIcon?: IconName;
  external?: boolean;
  block?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  icon = 'arrow',
  leadingIcon,
  external = false,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'btn',
  variant !== 'primary' && `btn--${variant}`,
  size === 'small' && 'btn--small',
  block && 'btn--block',
  className,
];
const Tag = href ? 'a' : 'button';
const externalAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
---

<Tag class:list={classes} href={href} {...externalAttrs} {...rest}>
  {leadingIcon && <Icon name={leadingIcon} class="btn__icon btn__icon--lead" />}
  <span><slot /></span>
  {external && <span class="sr-only">(nouvel onglet)</span>}
  {!leadingIcon && icon && <Icon name={icon} class="btn__icon" />}
</Tag>
