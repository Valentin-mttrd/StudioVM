---
/**
 * Typographic logotype. The "y" is set in the wonky italic and tilted a
 * few degrees: the one letter that doesn't stand like the others — the
 * name, drawn. Replace with the institute's own logo if it has one.
 */
interface Props {
  size?: 'nav' | 'footer';
  tagline?: boolean;
}
const { size = 'nav', tagline = true } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>
  <span class="wordmark__name" aria-hidden="true">L<span class="wordmark__apos">’</span>a<span class="wordmark__y">ty</span>pique</span>
  <span class="sr-only">L’atypique</span>
  {tagline && <span class="wordmark__tag"><span class="sr-only">, </span>Institut de beauté · Lorient</span>}
</span>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    color: inherit;
  }
  .wordmark__name {
    font-family: var(--f-display);
    font-weight: 380;
    font-size: 1.7rem;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .wordmark__apos {
    color: var(--c-argile);
  }
  :global(.on-dark) .wordmark__apos {
    color: var(--c-mais-vif);
  }
  .wordmark__y {
    display: inline-block;
    font-style: italic;
    font-weight: 340;
    transform: rotate(-7deg) translateY(0.02em);
    margin-inline: 0.02em 0.04em;
  }
  .wordmark__tag {
    margin-top: 0.35rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.72;
  }
  .wordmark--footer .wordmark__name {
    display: block;
    font-size: min(25.5vw, 23.5rem);
    font-weight: 330;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }
  .wordmark--footer .wordmark__y {
    transform: rotate(-4deg);
    margin-inline: 0.035em 0.03em;
  }
</style>
