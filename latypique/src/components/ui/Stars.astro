---
/** Five stars filled to `value` (e.g. 4.9 → 98 %). Decorative: the number is always written next to it. */
interface Props {
  value: number;
  max?: number;
}
const { value, max = 5 } = Astro.props;
const percent = Math.max(0, Math.min(100, (value / max) * 100));
const star =
  'M12 3.6l2.55 5.3 5.8.7-4.28 4 1.1 5.76L12 16.55 6.83 19.4l1.1-5.77-4.28-4 5.8-.7L12 3.6z';
---

<span class="stars" style={`--fill:${percent}%`} aria-hidden="true">
  <span class="stars__row stars__row--base">
    {Array.from({ length: max }, () => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}
  </span>
  <span class="stars__row stars__row--fill">
    {Array.from({ length: max }, () => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}
  </span>
</span>

<style>
  .stars {
    position: relative;
    display: inline-block;
    line-height: 0;
  }
  .stars__row {
    display: inline-flex;
    gap: 0.1rem;
  }
  .stars svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }
  .stars__row--base {
    color: var(--line-strong);
  }
  .stars__row--fill {
    position: absolute;
    inset: 0;
    color: var(--p-mais-deep);
    clip-path: inset(0 calc(100% - var(--fill)) 0 0);
  }
</style>
