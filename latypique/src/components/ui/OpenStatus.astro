---
/**
 * "Ouvert · jusqu'à 19h" — computed in the visitor's browser against the
 * institute's hours in Europe/Paris (static HTML can't know the time).
 * Without JS, the week's hours summary shows instead.
 */
import { groupedHours } from '@/lib/hours';

interface Props {
  variant?: 'inline' | 'badge';
  class?: string;
}
const { variant = 'inline', class: className } = Astro.props;
const summary = groupedHours()
  .filter((g) => !g.closed)
  .map((g) => `${g.days} ${g.hours}`)
  .join(' · ');
---

<span class:list={['open-status', `open-status--${variant}`, className]} data-open-status>
  <span class="open-status__dot" aria-hidden="true"></span>
  <span class="open-status__text" data-open-status-text>{summary}</span>
</span>

<script>
  import { openStatus } from '@/lib/hours';

  function render() {
    const status = openStatus();
    document.querySelectorAll<HTMLElement>('[data-open-status]').forEach((el) => {
      el.dataset.state = status.state;
      const text = el.querySelector('[data-open-status-text]');
      if (text) text.textContent = status.detail ? `${status.label} · ${status.detail}` : status.label;
    });
  }

  render();
  // Keep it right if the tab stays open across an opening or closing time.
  setInterval(render, 60_000);
</script>

<style>
  .open-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    line-height: 1.3;
  }
  .open-status__dot {
    position: relative;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    flex: none;
    background: currentColor;
    opacity: 0.45;
  }
  .open-status[data-state='open'] .open-status__dot {
    background: #4f8a5b;
    opacity: 1;
  }
  .open-status[data-state='closing'] .open-status__dot {
    background: #c98a2e;
    opacity: 1;
  }
  .open-status[data-state='closed'] .open-status__dot {
    background: var(--c-argile);
    opacity: 1;
  }
  :global(.on-dark) .open-status[data-state='closed'] .open-status__dot {
    background: var(--p-argile);
  }
  @media (prefers-reduced-motion: no-preference) {
    .open-status[data-state='open'] .open-status__dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: pulse 2.6s var(--ease-breath) infinite;
    }
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }
  .open-status--badge {
    padding: 0.45rem 0.85rem 0.45rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgb(250 246 240 / 0.7);
    font-size: 0.86rem;
    font-weight: 500;
  }
</style>
