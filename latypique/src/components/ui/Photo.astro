---
/**
 * Real photo when one is provided, clearly labelled placeholder otherwise.
 *
 * The institute's own photos (cabins, façade, products, hands at work)
 * were not reachable during the audit — see AUDIT.md. Drop a file in
 * src/assets/photos/, import it and pass it as `image`: Astro then serves
 * responsive AVIF/WebP with explicit dimensions (no layout shift).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Tone } from '@/data/soins';
import { site } from '@/data/site';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /** What the photo should show — printed on the placeholder. */
  label: string;
  ratio?: string;
  tone?: Tone;
  shape?: 'rect' | 'arch' | 'soft';
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt,
  label,
  ratio = '4 / 5',
  tone = 'lin',
  shape = 'soft',
  sizes = '(min-width: 64rem) 40vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;
---

<figure class:list={['photo', `photo--${shape}`, className]} style={`--ratio:${ratio};--tone:var(--p-${tone});--tone-d:var(--p-${tone}-deep)`}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="photo__img"
      />
    ) : (
      <div
        class="photo__placeholder"
        role={site.showPhotoPlaceholderLabels ? 'img' : undefined}
        aria-label={site.showPhotoPlaceholderLabels ? `Photo à venir : ${label}` : undefined}
        aria-hidden={site.showPhotoPlaceholderLabels ? undefined : 'true'}
      >
        {site.showPhotoPlaceholderLabels && (
          <span class="photo__tag">
            <span class="photo__tag-k">Photo à venir</span>
            <span class="photo__tag-v">{label}</span>
          </span>
        )}
      </div>
    )
  }
</figure>

<style>
  .photo {
    position: relative;
    container-type: inline-size;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--c-sable);
    isolation: isolate;
  }
  .photo--soft {
    border-radius: var(--r-m);
  }
  .photo--arch {
    border-radius: var(--r-arch);
  }
  .photo :global(.photo__img),
  .photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: clamp(0.75rem, 2.5vw, 1.25rem);
    background:
      radial-gradient(70% 55% at 28% 22%, rgb(255 255 255 / 0.45), transparent 70%),
      radial-gradient(80% 70% at 78% 88%, color-mix(in oklab, var(--tone-d) 55%, transparent), transparent 75%),
      linear-gradient(160deg, color-mix(in oklab, var(--tone) 55%, var(--c-lin)), color-mix(in oklab, var(--tone) 85%, var(--c-sable)));
  }
  /* Fine linen weave, so the placeholder reads as a surface, not an error. */
  .photo__placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background:
      repeating-linear-gradient(0deg, rgb(42 34 28 / 0.12) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.25) 0 1px, transparent 1px 5px);
    mix-blend-mode: multiply;
  }
  .photo__tag {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 100%;
    padding: 0.55rem 0.8rem;
    border: 1px dashed rgb(42 34 28 / 0.4);
    border-radius: var(--r-s);
    background: rgb(250 246 240 / 0.82);
    backdrop-filter: blur(6px);
    color: var(--c-ecorce);
    line-height: 1.2;
  }
  .photo__tag-k {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-argile);
  }
  .photo__tag-v {
    font-size: 0.85rem;
    font-weight: 500;
  }
  @container (max-width: 12rem) {
    .photo__tag {
      padding: 0.4rem 0.55rem;
    }
    .photo__tag-k {
      font-size: 0.56rem;
      letter-spacing: 0.1em;
    }
    .photo__tag-v {
      font-size: 0.74rem;
    }
  }
</style>
