---
/**
 * Line icons, drawn on one 24px grid with a 1.5 stroke so they sit with
 * the hairlines of the labels. Decorative by default (aria-hidden); pass
 * `label` when the icon is the only content of a control.
 */
export type IconName =
  | 'arrow'
  | 'external'
  | 'phone'
  | 'pin'
  | 'clock'
  | 'calendar'
  | 'instagram'
  | 'facebook'
  | 'star'
  | 'menu'
  | 'close'
  | 'plus'
  | 'car'
  | 'leaf'
  | 'route';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
  arrow: '<path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/>',
  external: '<path d="M7 17 17 7M9 7h8v8"/>',
  phone:
    '<path d="M5.5 3.8h3l1.5 4-2 1.3a11 11 0 0 0 6.9 6.9l1.3-2 4 1.5v3a1.8 1.8 0 0 1-1.9 1.8A16.6 16.6 0 0 1 3.7 5.7 1.8 1.8 0 0 1 5.5 3.8Z"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21Z"/><circle cx="12" cy="9.8" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  calendar: '<rect x="3.75" y="5" width="16.5" height="15" rx="2.5"/><path d="M3.75 9.5h16.5M8 3v4M16 3v4"/>',
  instagram:
    '<rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.1" cy="6.9" r=".6" fill="currentColor"/>',
  facebook: '<path d="M14.5 8.5H16V5.2h-2.2a3.6 3.6 0 0 0-3.6 3.6v2.1H8v3.3h2.2V20h3.3v-5.8h2.2l.5-3.3h-2.7V9.2a.7.7 0 0 1 .7-.7Z"/>',
  star: '<path d="m12 3.6 2.55 5.3 5.8.7-4.28 4 1.1 5.76L12 16.55 6.83 19.4l1.1-5.77-4.28-4 5.8-.7L12 3.6Z" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 8.5h16M4 15.5h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  car: '<path d="M5 16.5V12l1.8-4.6A2 2 0 0 1 8.7 6h6.6a2 2 0 0 1 1.9 1.4L19 12v4.5M5 16.5h14M5 16.5V19M19 16.5V19M5 12h14"/><circle cx="8" cy="14.2" r=".4" fill="currentColor"/><circle cx="16" cy="14.2" r=".4" fill="currentColor"/>',
  leaf: '<path d="M5 19c0-8 5.5-13.5 14-14 .3 8.4-5 14-13 14h-1Zm0 0 7-7"/>',
  route:
    '<circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M8 18h7.5a3 3 0 0 0 0-6h-7a3 3 0 0 1 0-6H16"/>',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
</style>
