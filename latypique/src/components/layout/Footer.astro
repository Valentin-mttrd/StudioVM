---
import Wordmark from '@/components/ui/Wordmark.astro';
import Icon from '@/components/ui/Icon.astro';
import OpenStatus from '@/components/ui/OpenStatus.astro';
import { business, mapLinks } from '@/data/business';
import { nav, legalNav } from '@/data/nav';
import { groupedHours } from '@/lib/hours';

const year = new Date().getFullYear();
const week = groupedHours();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col">
        <p class="label label--rule">L’institut</p>
        <address class="footer__text">
          {business.name} — {business.activity.toLowerCase()} slow cosmétique<br />
          {business.address.street}<br />
          {business.address.postalCode} {business.address.city}
        </address>
        <a class="link footer__link" href={mapLinks.google} target="_blank" rel="noopener">
          Itinéraire<span class="sr-only"> (nouvel onglet)</span>
          <Icon name="external" class="btn__icon" />
        </a>
      </div>

      <div class="footer__col">
        <p class="label label--rule">Horaires</p>
        <dl class="footer__hours">
          {
            week.map((g) => (
              <div>
                <dt>{g.days}</dt>
                <dd>{g.closed ? 'Fermé' : g.hours}</dd>
              </div>
            ))
          }
        </dl>
        <OpenStatus class="footer__status" />
      </div>

      <div class="footer__col">
        <p class="label label--rule">Contact</p>
        <ul class="footer__list" role="list">
          <li>
            <a href={business.phone.href} class="footer__contact">
              <Icon name="phone" />
              {business.phone.display}
            </a>
          </li>
          <li>
            <a href={business.booking.url} class="footer__contact" target="_blank" rel="noopener">
              <Icon name="calendar" />
              Réserver en ligne<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
          <li>
            <a href={business.links.instagram} class="footer__contact" target="_blank" rel="noopener">
              <Icon name="instagram" />
              {business.links.instagramHandle}<span class="sr-only"> sur Instagram (nouvel onglet)</span>
            </a>
          </li>
          <li>
            <a href={business.links.facebook} class="footer__contact" target="_blank" rel="noopener">
              <Icon name="facebook" />
              Facebook<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer__col" aria-label="Plan du site">
        <p class="label label--rule">Le site</p>
        <ul class="footer__list" role="list">
          <li><a href="/">Accueil</a></li>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <a href="/" class="footer__mark">
      <Wordmark size="footer" tagline={false} />
      <span class="sr-only"> — accueil</span>
    </a>

    <div class="footer__bottom">
      <p>© {year} {business.name}, {business.city}</p>
      <ul role="list">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <a href="https://www.studiovm-design.fr" target="_blank" rel="noopener">
            Site conçu par Studio VM<span class="sr-only"> (nouvel onglet)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: var(--s-8);
    padding-bottom: var(--s-5);
    background: var(--c-sable);
    overflow: hidden;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--s-7) var(--s-6);
  }
  .footer__col {
    display: grid;
    align-content: start;
    gap: var(--s-4);
  }
  .footer__col .label {
    color: var(--c-argile);
  }
  .footer__text {
    line-height: 1.7;
  }
  .footer__link {
    justify-self: start;
    font-size: 0.95rem;
  }
  .footer__hours {
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
  }
  .footer__hours div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed var(--line);
  }
  .footer__hours dd {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .footer__status {
    font-size: 0.9rem;
  }
  .footer__list {
    display: grid;
    gap: 0.35rem;
  }
  .footer__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.25rem;
    text-decoration: none;
  }
  .footer__contact :global(.icon) {
    color: var(--c-argile);
  }
  @media (hover: hover) {
    .footer__list a:hover {
      text-decoration: underline;
    }
  }

  /* The name set as a horizon, edge to edge. */
  .footer__mark {
    display: block;
    margin-top: var(--s-8);
    margin-bottom: var(--s-3);
    color: var(--c-ecorce);
    text-decoration: none;
  }
  .footer__mark:focus-visible {
    outline-offset: 4px;
  }

  .footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
    font-size: 0.85rem;
    color: var(--c-ecorce-doux);
    background: var(--c-sable);
  }
  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .footer__bottom a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.35rem;
  }
  @media (hover: hover) {
    .footer__bottom a:hover {
      text-decoration: underline;
    }
  }
  @media (max-width: 55.99rem) {
    .footer {
      padding-bottom: calc(var(--s-5) + 5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
