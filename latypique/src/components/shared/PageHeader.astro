---
import Pebble from '@/components/ui/Pebble.astro';
import type { Tone } from '@/data/soins';

interface Props {
  /** Breadcrumb label for the current page. */
  crumb: string;
  eyebrow: string;
  title: string;
  accent?: string;
  lead?: string;
  tones?: [Tone, Tone];
}

const { crumb, eyebrow, title, accent, lead, tones = ['argile', 'mais'] } = Astro.props;
---

<header class="page-header">
  <div class="container page-header__grid">
    <div class="page-header__copy">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <ol role="list">
          <li><a href="/">Accueil</a></li>
          <li aria-current="page">{crumb}</li>
        </ol>
      </nav>
      <p class="label label--rule page-header__eyebrow">{eyebrow}</p>
      <h1 class="display page-header__title">
        <span class="page-header__line"><span>{title}</span></span>{' '}
        {
          accent && (
            <span class="page-header__line">
              <span>
                <em>{accent}</em>
              </span>
            </span>
          )
        }
      </h1>
      {lead && <p class="lead page-header__lead">{lead}</p>}
      <slot />
    </div>
    <div class="page-header__matter" aria-hidden="true">
      <Pebble tone={tones[0]} size="clamp(7rem, 4rem + 12vw, 16rem)" shape={2} breathe />
      <Pebble tone={tones[1]} size="clamp(4rem, 2.5rem + 6vw, 8rem)" shape={3} breathe style="--breathe-delay:-4s" class="page-header__pebble-2" />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: var(--s-8);
    overflow: clip;
  }
  .page-header__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-6);
  }
  .page-header__copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--c-ecorce-doux);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.6;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .page-header__eyebrow {
    color: var(--c-argile);
  }
  .page-header__title {
    font-size: var(--t-h1);
    font-weight: 330;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .page-header__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .page-header__line > span {
    display: inline-block;
  }
  .page-header__lead {
    max-width: 36em;
  }
  .page-header__matter {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding-right: var(--s-4);
  }
  .page-header__matter :global(.page-header__pebble-2) {
    margin-left: -2rem;
    margin-bottom: -1rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-header__line > span {
      animation: ph-line 1000ms var(--ease-settle) both;
    }
    .page-header__line + .page-header__line > span {
      animation-delay: 90ms;
    }
    .page-header__lead,
    .page-header__eyebrow {
      animation: ph-settle 1100ms var(--ease-settle) 160ms both;
    }
    .page-header__matter {
      animation: ph-settle 1500ms var(--ease-settle) 240ms both;
    }
  }
  @keyframes ph-line {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes ph-settle {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @media (max-width: 47.99rem) {
    .page-header__grid {
      grid-template-columns: 1fr;
    }
    .page-header__matter {
      display: none;
    }
  }
</style>
