---
/**
 * Closing block of every page: book, call, or come — with the week's
 * hours and the address one glance away. The site's conversion point.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Pebble from '@/components/ui/Pebble.astro';
import OpenStatus from '@/components/ui/OpenStatus.astro';
import HoursTable from './HoursTable.astro';
import { business, mapLinks } from '@/data/business';

interface Props {
  title?: string;
  /** Italic accent appended to the title. */
  accent?: string;
}
const { title = 'Votre moment,', accent = 'en quelques clics.' } = Astro.props;
---

<section class="visit on-dark" aria-labelledby="visit-title">
  <div class="visit__pebbles" aria-hidden="true">
    <Pebble tone="argile" size="18rem" shape={2} breathe class="visit__pebble visit__pebble--a" />
  </div>

  <div class="container visit__grid">
    <div class="visit__copy">
      <p class="label label--rule visit__eyebrow">Réserver</p>
      <h2 class="display h2" id="visit-title" data-reveal>
        {title} <em>{accent}</em>
      </h2>
      <p class="lead" data-reveal>
        Choisissez votre soin et votre créneau sur l’agenda en ligne de l’institut. Vous préférez en parler&nbsp;?
        Appelez-nous.
      </p>
      <div class="visit__ctas" data-reveal>
        <Button href={business.booking.url} variant="light" external>Prendre rendez-vous</Button>
        <Button href={business.phone.href} variant="ghost-light" leadingIcon="phone">{business.phone.display}</Button>
      </div>
      <p class="visit__note">Réservation en ligne via {business.booking.provider}.</p>
    </div>

    <div class="visit__card" data-reveal>
      <div class="visit__block">
        <p class="label visit__label"><Icon name="pin" /> Adresse</p>
        <address class="visit__address">
          {business.name}<br />
          {business.address.street}<br />
          {business.address.postalCode} {business.address.city}
        </address>
        <p class="visit__parking"><Icon name="car" /> {business.facilities.parking}</p>
        <ul class="visit__maps" role="list" aria-label="Itinéraire">
          <li><a href={mapLinks.google} target="_blank" rel="noopener">Google Maps<span class="sr-only"> (nouvel onglet)</span></a></li>
          <li><a href={mapLinks.apple} target="_blank" rel="noopener">Plans<span class="sr-only"> d’Apple (nouvel onglet)</span></a></li>
          <li><a href={mapLinks.waze} target="_blank" rel="noopener">Waze<span class="sr-only"> (nouvel onglet)</span></a></li>
        </ul>
      </div>
      <div class="visit__block">
        <div class="visit__hours-head">
          <p class="label visit__label"><Icon name="clock" /> Horaires</p>
          <OpenStatus />
        </div>
        <HoursTable />
      </div>
    </div>
  </div>
</section>

<style>
  .visit {
    position: relative;
    padding-block: var(--s-9);
    overflow: clip;
  }
  .visit__pebbles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .visit :global(.visit__pebble) {
    position: absolute;
    opacity: 0.9;
  }
  .visit :global(.visit__pebble--a) {
    top: -6rem;
    right: -5rem;
  }

  .visit__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .visit__copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .visit__eyebrow {
    color: var(--c-mais-vif);
  }
  .visit__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .visit__note {
    font-size: 0.85rem;
    color: var(--c-creme-doux);
  }

  .visit__card {
    display: grid;
    gap: var(--s-6);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line-on-dark);
    border-radius: var(--r-l);
    background: rgb(49 61 53 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .visit__block {
    display: grid;
    gap: var(--s-3);
  }
  .visit__block + .visit__block {
    padding-top: var(--s-6);
    border-top: 1px solid var(--line-on-dark);
  }
  .visit__label {
    color: var(--c-mais-vif);
    gap: 0.5em;
  }
  .visit__label :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .visit__address {
    font-family: var(--f-display);
    font-size: 1.45rem;
    font-weight: 350;
    line-height: 1.3;
  }
  .visit__parking {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--c-creme-doux);
  }
  .visit__maps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }
  .visit__maps a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line-on-dark);
    border-radius: var(--r-pill);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--d-base) var(--ease-settle),
      color var(--d-base) var(--ease-settle);
  }
  @media (hover: hover) {
    .visit__maps a:hover {
      background: var(--c-creme);
      color: var(--c-mousse);
    }
  }
  .visit__hours-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    font-size: 0.9rem;
  }

  @media (max-width: 63.99rem) {
    .visit__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }
  @media (max-width: 47.99rem) {
    .visit__ctas :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
