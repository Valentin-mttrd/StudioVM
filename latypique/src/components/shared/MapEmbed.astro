---
/**
 * Two-step map: a drawn stand-in first, Google Maps only on request.
 * Nothing from Google loads (no cookies, no tracking, no 500 KB of JS)
 * until the visitor asks for it — see /confidentialite.
 */
import Icon from '@/components/ui/Icon.astro';
import { business, mapLinks } from '@/data/business';
---

<div class="map" data-map>
  <div class="map__stand-in" data-map-stand-in>
    <div class="map__streets" aria-hidden="true"></div>
    <div class="map__pin" aria-hidden="true">
      <span class="map__pin-dot"></span>
      <span class="map__pin-label">{business.name}</span>
    </div>
    <div class="map__panel">
      <p class="map__address">
        <strong>{business.address.street}</strong><br />
        {business.address.postalCode} {business.address.city}
      </p>
      <div class="map__actions">
        <button class="btn btn--small" type="button" data-map-load>
          <span>Afficher la carte</span>
          <Icon name="pin" class="btn__icon" />
        </button>
        <a class="link" href={mapLinks.google} target="_blank" rel="noopener">
          Ouvrir dans Google Maps<span class="sr-only"> (nouvel onglet)</span>
          <Icon name="external" class="btn__icon" />
        </a>
      </div>
      <p class="map__note">La carte interactive est fournie par Google, qui peut déposer des cookies.</p>
    </div>
  </div>
</div>

<script>
  import { mapLinks } from '@/data/business';

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const button = map.querySelector<HTMLButtonElement>('[data-map-load]');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = mapLinks.embed;
      iframe.title = 'Carte : L’atypique, 14 rue du Général Dubail, Lorient';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'map__frame';
      map.append(iframe);
      map.dataset.loaded = '';
      iframe.focus();
    });
  });
</script>

<style>
  .map {
    position: relative;
    aspect-ratio: 16 / 7;
    min-height: 24rem;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--c-sable);
    border: 1px solid var(--line);
  }
  .map :global(.map__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map[data-loaded] .map__stand-in {
    display: none;
  }
  .map__stand-in {
    position: absolute;
    inset: 0;
  }
  /* A soft, drawn street plan — suggests a map without pretending to be one. */
  .map__streets {
    position: absolute;
    inset: -10%;
    background:
      linear-gradient(28deg, transparent 47%, rgb(250 246 240 / 0.9) 47.4%, rgb(250 246 240 / 0.9) 49.6%, transparent 50%),
      linear-gradient(-62deg, transparent 58%, rgb(250 246 240 / 0.85) 58.3%, rgb(250 246 240 / 0.85) 60%, transparent 60.3%),
      linear-gradient(95deg, transparent 30%, rgb(250 246 240 / 0.7) 30.2%, rgb(250 246 240 / 0.7) 31.2%, transparent 31.4%),
      linear-gradient(8deg, transparent 72%, rgb(250 246 240 / 0.7) 72.2%, rgb(250 246 240 / 0.7) 73.4%, transparent 73.6%),
      radial-gradient(40% 50% at 82% 18%, rgb(163 173 142 / 0.45), transparent 70%),
      radial-gradient(30% 40% at 12% 85%, rgb(163 173 142 / 0.35), transparent 70%),
      repeating-linear-gradient(0deg, rgb(42 34 28 / 0.035) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgb(42 34 28 / 0.035) 0 1px, transparent 1px 28px);
  }
  .map__pin {
    position: absolute;
    left: 52%;
    top: 42%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transform: translate(-0.6rem, -50%);
  }
  .map__pin-dot {
    position: relative;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--c-argile);
    box-shadow: 0 0 0 6px rgb(154 78 53 / 0.18);
  }
  .map__pin-label {
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--c-ecorce);
    color: var(--c-creme);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .map__panel {
    position: absolute;
    left: var(--s-5);
    bottom: var(--s-5);
    display: grid;
    gap: var(--s-4);
    max-width: 26rem;
    padding: var(--s-5);
    border-radius: var(--r-m);
    background: rgb(250 246 240 / 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-soft);
  }
  .map__address {
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .map__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }
  .map__actions .link {
    font-size: 0.92rem;
  }
  .map__note {
    font-size: 0.8rem;
    color: var(--c-ecorce-doux);
  }
  @media (max-width: 47.99rem) {
    .map {
      aspect-ratio: auto;
      min-height: 30rem;
    }
    .map__panel {
      left: var(--s-3);
      right: var(--s-3);
      bottom: var(--s-3);
    }
    .map__pin {
      top: 28%;
      left: 40%;
    }
  }
</style>
