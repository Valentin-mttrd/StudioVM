---
/**
 * The treatment menu as an index — numbered rows, like a printed carte.
 * On desktop a pebble of the family's matter follows the pointer over the
 * list (swap it for the family's photo once photos exist).
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Pebble from '@/components/ui/Pebble.astro';
import { soins } from '@/data/soins';
import { business } from '@/data/business';
---

<section class="index section" aria-labelledby="index-title">
  <div class="container">
    <header class="index__head">
      <div>
        <p class="label label--rule index__eyebrow">La carte des soins</p>
        <h2 class="display h2" id="index-title" data-reveal>
          Une large gamme de soins, <em>adaptés à vos envies</em> et à vos besoins.
        </h2>
      </div>
      <div class="index__aside" data-reveal>
        <p class="muted">
          Visage, corps, minceur, épilation, mains, pieds, maquillage : les tarifs et les durées de chaque prestation
          sont affichés sur l’agenda en ligne au moment de réserver.
        </p>
        <Button href="/soins" variant="ghost">Voir toute la carte</Button>
      </div>
    </header>

    <div class="index__wrap" data-index>
      <ol class="index__list" role="list" data-reveal-group>
        {
          soins.map((family, i) => (
            <li data-reveal>
              <a class="index__row" href={`/soins#${family.id}`} data-tone={family.tone}>
                <span class="index__num num">{String(i + 1).padStart(2, '0')}</span>
                <span class="index__name display">{family.name}</span>
                <span class="index__summary">{family.summary}</span>
                <span class="index__arrow" aria-hidden="true">
                  <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="index__preview" aria-hidden="true" data-index-preview>
        {soins.map((family, i) => <Pebble tone={family.tone} size="12rem" shape={((i % 4) + 1) as 1 | 2 | 3 | 4} class="index__pebble" data-preview={family.tone} />)}
      </div>
    </div>

    <p class="index__book" data-reveal>
      <span class="muted">Vous savez déjà ce qu’il vous faut ?</span>
      <a class="link" href={business.booking.url} target="_blank" rel="noopener">
        Réserver directement<span class="sr-only"> (nouvel onglet)</span>
        <Icon name="arrow" class="btn__icon" />
      </a>
    </p>
  </div>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-index]');
  const preview = document.querySelector<HTMLElement>('[data-index-preview]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 64rem)');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (wrap && preview && fine.matches) {
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let frame = 0;
    const ease = calm.matches ? 1 : 0.14;

    const tick = () => {
      x += (tx - x) * ease;
      y += (ty - y) * ease;
      preview.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(tick) : 0;
    };

    wrap.addEventListener('pointermove', (event) => {
      const box = wrap.getBoundingClientRect();
      tx = event.clientX - box.left;
      ty = event.clientY - box.top;
      if (!frame) frame = requestAnimationFrame(tick);
    });

    wrap.querySelectorAll<HTMLElement>('[data-tone]').forEach((row) => {
      const show = () => {
        wrap.dataset.previewing = row.dataset.tone;
      };
      row.addEventListener('pointerenter', show);
      row.addEventListener('focus', show);
    });
    wrap.addEventListener('pointerleave', () => delete wrap.dataset.previewing);
    wrap.addEventListener('focusout', (event) => {
      if (!wrap.contains(event.relatedTarget as Node)) delete wrap.dataset.previewing;
    });
  }
</script>

<style>
  .index__head {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--s-6);
    margin-bottom: var(--s-7);
  }
  .index__eyebrow {
    color: var(--c-argile);
    margin-bottom: var(--s-4);
  }
  .index__aside {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .index__wrap {
    position: relative;
  }
  .index__list {
    border-top: 1px solid var(--line-strong);
  }
  .index__row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.3fr) minmax(0, 1fr) 3rem;
    align-items: center;
    gap: var(--s-5);
    padding: clamp(1.2rem, 1rem + 1vw, 2rem) 0;
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
    z-index: 1;
    transition: padding var(--d-base) var(--ease-settle);
  }
  .index__num {
    color: var(--c-argile);
    font-size: 1.1rem;
  }
  .index__name {
    font-size: clamp(1.7rem, 1.2rem + 2vw, 3.25rem);
    font-weight: 340;
    letter-spacing: -0.025em;
    line-height: 1.05;
    transition:
      transform var(--d-slow) var(--ease-settle),
      font-style 0s;
  }
  .index__summary {
    color: var(--c-ecorce-doux);
    font-size: 0.98rem;
    max-width: 26em;
  }
  .index__arrow {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color var(--d-base) var(--ease-settle),
      color var(--d-base) var(--ease-settle),
      border-color var(--d-base) var(--ease-settle),
      transform var(--d-base) var(--ease-settle);
  }
  @media (hover: hover) {
    .index__row:hover .index__name,
    .index__row:focus-visible .index__name {
      transform: translateX(0.6rem);
      font-style: italic;
      color: var(--c-argile);
    }
    .index__row:hover .index__arrow,
    .index__row:focus-visible .index__arrow {
      background: var(--c-ecorce);
      border-color: var(--c-ecorce);
      color: var(--c-creme);
      transform: rotate(-45deg);
    }
    /* Dim the other rows so the one under the pointer reads alone. */
    .index__list:has(.index__row:hover) .index__row:not(:hover) {
      opacity: 0.45;
    }
    .index__row {
      transition:
        opacity var(--d-base) var(--ease-settle),
        padding var(--d-base) var(--ease-settle);
    }
  }

  .index__preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 12rem;
    margin: -4rem 0 0 -6rem;
    pointer-events: none;
    display: grid;
    z-index: 0;
    opacity: 0;
    transition: opacity var(--d-base) var(--ease-settle);
  }
  .index__preview :global(.index__pebble) {
    grid-area: 1 / 1;
    opacity: 0;
    transform: scale(0.8) rotate(-10deg);
    transition:
      opacity var(--d-base) var(--ease-settle),
      transform var(--d-slow) var(--ease-settle);
  }
  [data-previewing] .index__preview {
    opacity: 1;
  }
  [data-previewing='argile'] :global([data-preview='argile']),
  [data-previewing='sauge'] :global([data-preview='sauge']),
  [data-previewing='cire'] :global([data-preview='cire']),
  [data-previewing='mais'] :global([data-preview='mais']),
  [data-previewing='lin'] :global([data-preview='lin']),
  [data-previewing='rose'] :global([data-preview='rose']),
  [data-previewing='soleil'] :global([data-preview='soleil']) {
    opacity: 0.92;
    transform: none;
  }

  .index__book {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-6);
  }
  .index__book .link {
    color: var(--c-argile);
  }

  @media (max-width: 63.99rem) {
    .index__head {
      grid-template-columns: 1fr;
    }
    .index__preview {
      display: none;
    }
  }
  @media (max-width: 47.99rem) {
    .index__row {
      grid-template-columns: 2.25rem minmax(0, 1fr) 2.5rem;
      grid-template-areas:
        'num name arrow'
        '. summary arrow';
      row-gap: 0.35rem;
      column-gap: var(--s-3);
    }
    .index__num {
      grid-area: num;
      align-self: baseline;
    }
    .index__name {
      grid-area: name;
    }
    .index__summary {
      grid-area: summary;
      font-size: 0.92rem;
    }
    .index__arrow {
      grid-area: arrow;
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
