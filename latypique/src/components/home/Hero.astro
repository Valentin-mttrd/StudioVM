---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Pebble from '@/components/ui/Pebble.astro';
import OpenStatus from '@/components/ui/OpenStatus.astro';
import { business, mapLinks } from '@/data/business';

const rating = business.rating.value.toLocaleString('fr-FR');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="label label--rule hero__eyebrow hero-in" style="--in:0">
          Institut de beauté slow cosmétique à {business.city}<span class="sr-only"> :</span>
        </span>{' '}
        <span class="hero__line display"><span style="--in:1">Prendre soin</span></span>{' '}
        <span class="hero__line display"><span style="--in:2">de vous,</span></span>{' '}
        <span class="hero__line display"><span style="--in:3"><em>autrement.</em></span></span>
      </h1>
      <p class="lead hero__lead hero-in" style="--in:4">
        Soins visage et corps aux produits 100 % naturels, semi-permanent à base de manioc et de maïs, épilation à
        la cire végétale&nbsp;: un moment beauté dans une ambiance chaleureuse, à {business.city}.
      </p>
      <div class="hero__ctas hero-in" style="--in:5">
        <Button href={business.booking.url} external>Prendre rendez-vous</Button>
        <Button href="/soins" variant="ghost">Découvrir les soins</Button>
      </div>
    </div>

    <!-- The composition: the three things that make the institute atypical,
         laid out like specimens on linen. Real content, not decoration. -->
    <ul class="specimens" role="list" aria-label="Ce qui rend L’atypique différent" data-specimens>
      <li class="specimen specimen--1" data-depth="1">
        <Pebble tone="argile" size="var(--sp-1)" shape={1} breathe style="--breathe-d:10s" />
        <p class="specimen__tag">
          <span class="num">N°01</span>
          <span>Produits 100 % naturels</span>
        </p>
      </li>
      <li class="specimen specimen--2" data-depth="1.8">
        <Pebble tone="mais" size="var(--sp-2)" shape={2} breathe style="--breathe-d:8s;--breathe-delay:-3s" />
        <p class="specimen__tag">
          <span class="num">N°02</span>
          <span>Semi-permanent manioc &amp; maïs</span>
        </p>
      </li>
      <li class="specimen specimen--3" data-depth="2.6">
        <Pebble tone="cire" size="var(--sp-3)" shape={3} breathe style="--breathe-d:7s;--breathe-delay:-5s" />
        <p class="specimen__tag">
          <span class="num">N°03</span>
          <span>Cire végétale</span>
        </p>
      </li>
    </ul>
  </div>

  <div class="container">
    <ul class="hero__facts hero-in" role="list" style="--in:6">
      <li>
        <Icon name="pin" />
        <span>
          <a href={mapLinks.google} target="_blank" rel="noopener">
            {business.address.street}, {business.address.city}<span class="sr-only"> — itinéraire (nouvel onglet)</span>
          </a>
          <small>{business.facilities.parking}</small>
        </span>
      </li>
      <li>
        <Icon name="clock" />
        <span>
          <OpenStatus />
          <small><a href="/infos-pratiques#horaires">Tous les horaires</a></small>
        </span>
      </li>
      <li>
        <Icon name="star" class="hero__star" />
        <span>
          <a href={mapLinks.reviews} target="_blank" rel="noopener">
            <strong>{rating}/5</strong> · {business.rating.countLabel}<span class="sr-only"> — lire les avis (nouvel onglet)</span>
          </a>
          <small>Note moyenne des avis clients en ligne</small>
        </span>
      </li>
    </ul>
  </div>
</section>

<script>
  /* Pointer parallax on the specimens: each drifts by its own depth, with
     a spring-ish lerp so they float rather than track. Desktop pointers
     only, off under reduced motion, paused when the hero is off screen. */
  const scene = document.querySelector<HTMLElement>('[data-specimens]');
  const fine = window.matchMedia('(pointer: fine) and (min-width: 64rem)');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (scene && fine.matches && !calm.matches) {
    const items = [...scene.querySelectorAll<HTMLElement>('[data-depth]')].map((el) => ({
      el,
      depth: Number(el.dataset.depth) || 1,
    }));
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let frame = 0;
    let visible = true;

    const tick = () => {
      x += (tx - x) * 0.06;
      y += (ty - y) * 0.06;
      for (const { el, depth } of items) {
        el.style.translate = `${(x * depth * 10).toFixed(2)}px ${(y * depth * 8).toFixed(2)}px`;
      }
      frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(tick) : 0;
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        if (!visible) return;
        tx = (event.clientX / window.innerWidth - 0.5) * 2;
        ty = (event.clientY / window.innerHeight - 0.5) * 2;
        if (!frame) frame = requestAnimationFrame(tick);
      },
      { passive: true },
    );

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(scene);
  }
</script>

<style>
  .hero {
    --sp-1: clamp(9rem, 4rem + 13vw, 19rem);
    --sp-2: clamp(6.5rem, 3rem + 8.5vw, 12.5rem);
    --sp-3: clamp(5rem, 2.5rem + 6vw, 9.5rem);
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--s-7);
    min-height: calc(100svh - var(--header-h));
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: var(--s-6);
    margin-top: 0;
    overflow: clip;
  }
  /* Warm window light from the top right, as on a treatment table. */
  .hero__glow {
    position: absolute;
    inset: -20% -10% auto 35%;
    height: 120%;
    background:
      radial-gradient(closest-side at 60% 38%, rgb(250 246 240 / 0.95), transparent 70%),
      radial-gradient(closest-side at 70% 55%, rgb(233 199 126 / 0.22), transparent 80%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s-6);
  }

  .hero__eyebrow {
    display: flex;
    color: var(--c-argile);
    margin-bottom: var(--s-5);
    text-wrap: balance;
  }
  .hero__title {
    font-weight: 400;
    line-height: 1;
  }
  .hero__line {
    font-size: var(--t-hero);
    font-weight: 330;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__line em {
    font-weight: 300;
    letter-spacing: -0.02em;
    padding-right: 0.05em;
  }
  .hero__lead {
    margin-top: var(--s-5);
    max-width: 34em;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  /* --- Specimens ------------------------------------------------------ */
  .specimens {
    position: relative;
    height: clamp(26rem, 18rem + 22vw, 40rem);
  }
  .specimen {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    will-change: translate;
  }
  .specimen--1 {
    top: 4%;
    left: 4%;
  }
  .specimen--2 {
    top: 40%;
    right: 2%;
    flex-direction: row-reverse;
  }
  .specimen--3 {
    bottom: 2%;
    left: 14%;
  }
  .specimen__tag {
    display: grid;
    gap: 0.15rem;
    max-width: 11rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-s);
    background: rgb(250 246 240 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.3;
    box-shadow: 0 10px 30px -18px rgb(42 34 28 / 0.35);
  }
  .specimen__tag .num {
    color: var(--c-argile);
    font-size: 0.95rem;
  }
  /* Leader line from tag to pebble, like a herbarium label. */
  .specimen__tag {
    position: relative;
  }
  .specimen__tag::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 100%;
    width: var(--s-4);
    height: 1px;
    background: var(--line-strong);
  }
  .specimen--2 .specimen__tag::before {
    right: auto;
    left: 100%;
  }

  /* --- Facts bar ------------------------------------------------------ */
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .hero__facts li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-4) 0 0;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .hero__facts li + li {
    padding-left: var(--s-5);
    border-left: 1px solid var(--line);
  }
  .hero__facts li > :global(.icon) {
    margin-top: 0.1rem;
    color: var(--c-argile);
  }
  .hero__facts li > span {
    display: grid;
    gap: 0.2rem;
  }
  .hero__facts a {
    text-decoration: none;
    font-weight: 500;
  }
  .hero__facts a:hover {
    text-decoration: underline;
  }
  .hero__facts small {
    font-size: 0.82rem;
    color: var(--c-ecorce-doux);
  }
  .hero__facts small a {
    font-weight: 400;
    text-decoration: underline;
  }
  .hero__facts :global(.hero__star) {
    color: var(--c-mais-vif) !important;
    filter: drop-shadow(0 0 0.5px var(--p-mais-deep));
  }

  /* --- Entrance: lines rise out of their mask, the rest settles ------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span {
      animation: line-in 1000ms var(--ease-settle) both;
      animation-delay: calc(var(--in) * 90ms);
    }
    .hero-in {
      animation: settle-in 1100ms var(--ease-settle) both;
      animation-delay: calc(120ms + var(--in) * 80ms);
    }
    .specimen {
      animation: specimen-in 1600ms var(--ease-settle) both;
    }
    .specimen--1 {
      animation-delay: 250ms;
    }
    .specimen--2 {
      animation-delay: 420ms;
    }
    .specimen--3 {
      animation-delay: 560ms;
    }
  }
  @keyframes line-in {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes settle-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  @keyframes specimen-in {
    from {
      opacity: 0;
      transform: translateY(2rem) scale(0.92);
    }
  }

  /* --- Tablet & phone ------------------------------------------------- */
  @media (max-width: 63.99rem) {
    .hero {
      min-height: auto;
      gap: var(--s-6);
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .specimens {
      height: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-3);
      --sp-1: clamp(5rem, 3rem + 10vw, 8rem);
      --sp-2: var(--sp-1);
      --sp-3: var(--sp-1);
    }
    .specimen {
      position: static;
      flex-direction: column !important;
      align-items: center;
      text-align: center;
      gap: var(--s-4);
    }
    .specimen__tag {
      max-width: none;
      width: 100%;
      background: transparent;
      border: 0;
      padding: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .specimen__tag::before {
      display: none;
    }
  }
  @media (max-width: 47.99rem) {
    .hero__facts {
      grid-template-columns: 1fr;
    }
    .hero__facts li,
    .hero__facts li + li {
      padding: var(--s-4) 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
    .hero__ctas :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
