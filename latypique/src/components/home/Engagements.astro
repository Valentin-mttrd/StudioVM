---
/**
 * The three commitments, one at a time. On large screens the matter stays
 * pinned on the left and changes as each commitment scrolls into focus —
 * the page slows the visitor down on exactly what makes the institute
 * different. On phones, each commitment simply carries its own pebble.
 */
import Pebble from '@/components/ui/Pebble.astro';
import Icon from '@/components/ui/Icon.astro';
import { engagements } from '@/data/soins';
---

<section class="engagements section on-dark" aria-labelledby="engagements-title" data-engagements data-active="0">
  <div class="container">
    <header class="engagements__head">
      <p class="label label--rule engagements__eyebrow">La composition</p>
      <h2 class="display h2" id="engagements-title" data-reveal>
        Prendre soin de vous <em>autrement</em>, en trois gestes.
      </h2>
    </header>

    <div class="engagements__grid">
      <div class="engagements__stage" aria-hidden="true">
        <div class="engagements__sticky">
          <div class="engagements__ring"></div>
          {
            engagements.map((item, i) => (
              <div class="engagements__matter" data-matter={i}>
                <Pebble tone={item.tone} size="min(26rem, 30vw)" shape={((i % 3) + 1) as 1 | 2 | 3} breathe />
              </div>
            ))
          }
          <p class="engagements__counter num">
            <span data-counter>01</span>
            <span class="engagements__of"> / 03</span>
          </p>
        </div>
      </div>

      <ol class="engagements__steps" role="list">
        {
          engagements.map((item, i) => (
            <li class="step" data-step={i}>
              <div class="step__pebble" aria-hidden="true">
                <Pebble tone={item.tone} size="6.5rem" shape={((i % 3) + 1) as 1 | 2 | 3} />
              </div>
              <p class="step__num num">N°{item.number}</p>
              <h3 class="display step__title">{item.title}</h3>
              <p class="step__text">{item.text}</p>
              <a class="link step__link" href={item.link.href}>
                {item.link.label}
                <Icon name="arrow" class="btn__icon" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-engagements]');
  if (section && 'IntersectionObserver' in window) {
    const counter = section.querySelector('[data-counter]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = (entry.target as HTMLElement).dataset.step ?? '0';
          section.dataset.active = index;
          if (counter) counter.textContent = String(Number(index) + 1).padStart(2, '0');
        }
      },
      // A step is "current" while it crosses the middle band of the screen.
      { rootMargin: '-45% 0px -45% 0px' },
    );
    section.querySelectorAll('[data-step]').forEach((step) => observer.observe(step));
  }
</script>

<style>
  .engagements__head {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
    margin-bottom: var(--s-8);
  }
  .engagements__eyebrow {
    color: var(--c-mais-vif);
  }

  .engagements__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-7);
  }
  .engagements__sticky {
    position: sticky;
    top: calc(50svh - min(15rem, 18vw));
    display: grid;
    place-items: center;
    height: min(30rem, 36vw);
  }
  .engagements__ring {
    position: absolute;
    width: min(30rem, 34vw);
    aspect-ratio: 1;
    border: 1px solid var(--line-on-dark);
    border-radius: 50%;
  }
  .engagements__ring::before {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px dashed var(--line-on-dark);
    border-radius: 50%;
  }
  .engagements__matter {
    grid-area: 1 / 1;
    opacity: 0;
    transform: scale(0.88) rotate(-8deg);
    transition:
      opacity 900ms var(--ease-settle),
      transform 1200ms var(--ease-settle);
  }
  [data-active='0'] [data-matter='0'],
  [data-active='1'] [data-matter='1'],
  [data-active='2'] [data-matter='2'] {
    opacity: 1;
    transform: none;
  }
  .engagements__counter {
    position: absolute;
    left: 0;
    bottom: -1rem;
    font-size: 1.1rem;
    color: var(--c-mais-vif);
  }
  .engagements__of {
    color: var(--c-creme-doux);
  }

  .engagements__steps {
    display: grid;
  }
  .step {
    display: grid;
    align-content: center;
    gap: var(--s-4);
    min-height: 72svh;
    padding-block: var(--s-7);
    border-top: 1px solid var(--line-on-dark);
    transition: opacity 700ms var(--ease-settle);
  }
  .step:last-child {
    min-height: 60svh;
  }
  .js [data-engagements] .step {
    opacity: 0.35;
  }
  .js [data-active='0'] [data-step='0'],
  .js [data-active='1'] [data-step='1'],
  .js [data-active='2'] [data-step='2'] {
    opacity: 1;
  }
  .step__pebble {
    display: none;
  }
  .step__num {
    color: var(--c-mais-vif);
    font-size: 1.15rem;
  }
  .step__title {
    font-size: var(--t-h3);
    font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem);
    font-weight: 340;
    line-height: 1.08;
    max-width: 15ch;
  }
  .step__text {
    max-width: 30em;
    color: var(--c-creme-doux);
    font-size: var(--t-lead);
  }
  .step__link {
    justify-self: start;
    color: var(--c-creme);
  }

  @media (max-width: 63.99rem) {
    .engagements__grid {
      grid-template-columns: 1fr;
    }
    .engagements__stage {
      display: none;
    }
    .step,
    .step:last-child {
      min-height: 0;
      padding-block: var(--s-6);
    }
    .js [data-engagements] .step {
      opacity: 1;
    }
    .step__pebble {
      display: block;
      margin-bottom: var(--s-2);
    }
  }
</style>
