---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Stars from '@/components/ui/Stars.astro';
import { business, mapLinks } from '@/data/business';

const rating = business.rating.value.toLocaleString('fr-FR');
---

<section class="teaser section" aria-labelledby="teaser-title">
  <div class="container teaser__grid">
    <div class="teaser__photos" data-reveal-group>
      <div class="teaser__photo teaser__photo--a" data-reveal>
        <Photo alt="" label="Une cabine de soins" ratio="4 / 5" tone="argile" shape="arch" />
      </div>
      <div class="teaser__photo teaser__photo--b" data-reveal>
        <Photo alt="" label="L’accueil de l’institut" ratio="1 / 1" tone="sauge" />
      </div>
      <div class="teaser__photo teaser__photo--c" data-reveal>
        <Photo alt="" label="Les produits naturels" ratio="3 / 4" tone="cire" />
      </div>
    </div>

    <div class="teaser__copy">
      <p class="label label--rule teaser__eyebrow">L’institut</p>
      <h2 class="display h2" id="teaser-title" data-reveal>
        Un espace <em>récemment rénové</em>, dans un cadre chaleureux.
      </h2>

      <dl class="teaser__facts" data-reveal-group>
        <div data-reveal>
          <dt class="display">{business.facilities.treatmentRooms}</dt>
          <dd>cabines de soins modernisées</dd>
        </div>
        <div data-reveal>
          <dt class="display">1</dt>
          <dd>cabine UV</dd>
        </div>
        <div data-reveal>
          <dt><Icon name="car" class="teaser__icon" /></dt>
          <dd>{business.facilities.parking.toLowerCase()}</dd>
        </div>
      </dl>

      <p class="teaser__text" data-reveal>
        Une équipe attentionnée, qui allie expertise technique et écoute, pour vous garantir une expérience de
        qualité — et vous aider à vous sentir mieux dans votre peau.
      </p>

      <a class="teaser__rating" href={mapLinks.reviews} target="_blank" rel="noopener" data-reveal>
        <span class="teaser__score display">{rating}<small>/5</small></span>
        <span class="teaser__rating-meta">
          <Stars value={business.rating.value} />
          <span>Note moyenne, {business.rating.countLabel} clients en ligne</span>
        </span>
        <span class="sr-only">— lire les avis (nouvel onglet)</span>
        <Icon name="external" class="teaser__rating-icon" />
      </a>

      <div data-reveal>
        <Button href="/institut" variant="ghost">Découvrir l’institut</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .teaser__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .teaser__photos {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: var(--s-4);
  }
  .teaser__photo--a {
    grid-column: 1 / 8;
    grid-row: 1 / 3;
  }
  .teaser__photo--b {
    grid-column: 8 / 13;
    grid-row: 1;
    align-self: end;
    margin-top: var(--s-8);
  }
  .teaser__photo--c {
    grid-column: 8 / 12;
    grid-row: 2;
  }

  .teaser__copy {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .teaser__eyebrow {
    color: var(--c-argile);
    margin-bottom: calc(-1 * var(--s-3));
  }
  .teaser__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    border-top: 1px solid var(--line-strong);
  }
  .teaser__facts > div {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: var(--s-4) var(--s-4) 0 0;
  }
  .teaser__facts > div + div {
    padding-left: var(--s-4);
    border-left: 1px solid var(--line);
  }
  .teaser__facts dt {
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.5rem);
    font-weight: 300;
    line-height: 1;
    color: var(--c-argile);
    min-height: 1em;
  }
  .teaser__facts dd {
    font-size: 0.92rem;
    line-height: 1.35;
    color: var(--c-ecorce-doux);
  }
  :global(.teaser__icon) {
    width: 1em !important;
    height: 1em !important;
    stroke-width: 1 !important;
  }
  .teaser__text {
    font-size: var(--t-lead);
    color: var(--c-ecorce-doux);
    max-width: 32em;
  }

  .teaser__rating {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    width: 100%;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    background: var(--c-lait);
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--d-base) var(--ease-settle),
      box-shadow var(--d-base) var(--ease-settle);
  }
  @media (hover: hover) {
    .teaser__rating:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }
  }
  .teaser__score {
    font-size: 2.75rem;
    font-weight: 330;
    line-height: 1;
  }
  .teaser__score small {
    font-size: 0.45em;
    color: var(--c-ecorce-doux);
  }
  .teaser__rating-meta {
    display: grid;
    gap: 0.25rem;
    font-size: 0.88rem;
    color: var(--c-ecorce-doux);
  }
  :global(.teaser__rating-icon) {
    margin-left: auto;
    color: var(--c-argile);
  }

  @media (max-width: 63.99rem) {
    .teaser__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .teaser__copy {
      order: -1;
    }
  }
  @media (max-width: 47.99rem) {
    .teaser__photos {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--s-3);
    }
    .teaser__photo--a {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .teaser__photo--b {
      grid-column: 2;
      margin-top: 0;
    }
    .teaser__photo--c {
      grid-column: 2;
    }
  }
  @media (max-width: 29.99rem) {
    .teaser__facts {
      grid-template-columns: 1fr;
    }
    .teaser__facts > div,
    .teaser__facts > div + div {
      grid-template-columns: 4rem 1fr;
      align-items: center;
      padding: var(--s-3) 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
