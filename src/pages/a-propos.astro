---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Logo from '../components/ui/Logo.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema } from '../lib/seo';

const steps = ['Comprendre', 'Concevoir', 'Développer', 'Rendre utile'];
---
<Layout
  title="À propos"
  description="Studio VM réunit conception, technologie et visualisation dans une même approche. Basé à Lorient, en Bretagne."
  structuredData={[breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'À propos', path: '/a-propos' }])]}
>
  <PageHeader
    eyebrow="À propos"
    title="Réunir conception, technologie et visualisation."
    emphasis="et visualisation."
  />

  <Section tone="paper">
    <Container>
      <div class="max-w-4xl">
        <p class="text-display-md" data-reveal data-reveal-mode="wave">
          Studio VM est né de la volonté de réunir <strong>conception, technologie et visualisation</strong> dans
          une même approche.
        </p>
        <p class="mt-10 max-w-2xl font-body text-lg font-light leading-relaxed text-anthracite/80" data-reveal data-reveal-delay="80">
          Plutôt que de séparer design, développement et image, Studio VM les traite comme un
          seul et même travail&nbsp;: celui de comprendre un besoin, puis de le rendre concret.
        </p>
      </div>

      <!-- One continuous current: each step flows into the next. -->
      <ol class="mt-20 grid grid-cols-2 gap-3 border-t border-ink/10 pt-12 sm:grid-cols-4" data-reveal data-reveal-mode="rise" data-reveal-delay="140">
        {
          steps.map((step, index) => (
            <li class="glass-light glass-hover glass-lift flex flex-col gap-8 rounded-[20px] p-6" data-sheen>
              <span class="font-display text-xs font-semibold text-accent">{String(index + 1).padStart(2, '0')}</span>
              <span class="font-display text-xl font-light tracking-tight sm:text-2xl">{step}</span>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section tone="sand">
    <Container>
      <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5" data-fluid>
          <div data-reveal data-reveal-mode="drop" style="--drop-radius: var(--radius-lens)">
            <div class="founder-pool reveal-clip-target relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lens bg-deep">
              <span class="founder-pool__light" aria-hidden="true"></span>
              <Logo variant="mark" tone="light" markClass="h-20 sm:h-24" class="relative" />
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="font-body text-xs font-semibold uppercase tracking-[0.24em] text-graphite" data-reveal data-reveal-fast>Fondateur</p>
          <h2 class="mt-5 text-display-md" data-reveal data-reveal-mode="wave">
            {SITE.founder}
          </h2>
          <p class="mt-7 max-w-xl font-body text-lg font-light leading-relaxed text-anthracite/80" data-reveal data-reveal-delay="80">
            J'ai fondé Studio VM pour réunir, sous un même toit, ce qui est habituellement
            séparé&nbsp;: la conception, le développement et la visualisation. L'objectif reste le
            même sur chaque projet — comprendre le besoin, concevoir la solution, la développer,
            et la rendre réellement utile.
          </p>
          <p class="chip mt-8 uppercase tracking-[0.16em]" data-reveal data-reveal-fast data-reveal-delay="120">
            <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            {SITE.locality}
          </p>
        </div>
      </div>
    </Container>
  </Section>
</Layout>

<style>
  /* A small pool of deep water around the mark, lit from above. */
  .founder-pool {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), inset 0 0 0 1px rgb(255 255 255 / 0.06), 0 50px 90px -46px rgb(18 21 24 / 0.7);
  }

  .founder-pool__light {
    position: absolute;
    inset: -30%;
    background:
      radial-gradient(40% 30% at 30% 20%, rgb(174 189 201 / 0.22), transparent 70%),
      radial-gradient(35% 28% at 75% 85%, rgb(70 96 122 / 0.35), transparent 70%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .founder-pool__light {
      animation: pool-light 16s var(--ease-in-out) infinite alternate;
    }
  }

  @keyframes pool-light {
    to { rotate: 25deg; scale: 1.1; }
  }
</style>
