---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema } from '../lib/seo';

const projectTypes = ['Site web', 'Application', '3D', 'Autre'];
const budgets = [
  'Moins de 2 000 €',
  '2 000 € – 5 000 €',
  '5 000 € – 10 000 €',
  'Plus de 10 000 €',
  'Je ne sais pas encore',
];

const inputClass =
  'w-full rounded-sm border border-mist bg-paper px-4 py-3 font-body text-base text-ink placeholder:text-graphite/60 transition-colors duration-200 focus:border-ink';
const labelClass = 'block font-body text-sm font-semibold text-ink';
---
<Layout
  title="Contact"
  description="Un projet de site web, d'application sur mesure ou de visualisation 3D ? Parlons-en. Studio VM répond sous quelques jours."
  structuredData={[breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Contact', path: '/contact' }])]}
>
  <PageHeader
    eyebrow="Contact"
    title="Parlons de votre projet."
    description="Décrivez votre besoin en quelques lignes. Studio VM revient vers vous rapidement pour en discuter."
  />

  <Section tone="paper">
    <Container>
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <form data-contact-form class="flex flex-col gap-7" novalidate>
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="societe_web">Ne pas remplir ce champ</label>
              <input type="text" id="societe_web" name="societe_web" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid grid-cols-1 gap-7 sm:grid-cols-2">
              <div>
                <label for="nom" class={labelClass}>Nom <span aria-hidden="true">*</span></label>
                <input type="text" id="nom" name="nom" required autocomplete="name" class:list={[inputClass, 'mt-2']} />
              </div>
              <div>
                <label for="entreprise" class={labelClass}>Entreprise <span class="font-normal text-graphite">(facultatif)</span></label>
                <input type="text" id="entreprise" name="entreprise" autocomplete="organization" class:list={[inputClass, 'mt-2']} />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-7 sm:grid-cols-2">
              <div>
                <label for="email" class={labelClass}>Email <span aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" class:list={[inputClass, 'mt-2']} />
              </div>
              <div>
                <label for="telephone" class={labelClass}>Téléphone <span class="font-normal text-graphite">(facultatif)</span></label>
                <input type="tel" id="telephone" name="telephone" autocomplete="tel" class:list={[inputClass, 'mt-2']} />
              </div>
            </div>

            <fieldset>
              <legend class={labelClass}>Type de projet <span aria-hidden="true">*</span></legend>
              <div class="mt-3 flex flex-wrap gap-3">
                {
                  projectTypes.map((type, index) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="projet" value={type} required={index === 0} class="peer sr-only" />
                      <span class="inline-flex rounded-sm border border-mist px-4 py-2.5 font-body text-sm text-ink transition-colors duration-200 peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                        {type}
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div>
              <label for="budget" class={labelClass}>Budget indicatif <span class="font-normal text-graphite">(facultatif)</span></label>
              <select id="budget" name="budget" class:list={[inputClass, 'mt-2']}>
                <option value="">Sélectionner une fourchette</option>
                {budgets.map((budget) => <option value={budget}>{budget}</option>)}
              </select>
            </div>

            <div>
              <label for="description" class={labelClass}>Description du projet <span aria-hidden="true">*</span></label>
              <textarea
                id="description"
                name="description"
                required
                rows="6"
                class:list={[inputClass, 'mt-2 resize-y']}
                placeholder="Contexte, objectifs, délais envisagés…"
              />
            </div>

            <p class="border-l-2 border-accent py-1 pl-4 font-body text-sm text-ink" data-form-status hidden></p>

            <Button type="submit" variant="solid" class="w-fit" data-submit>
              Envoyer ma demande
            </Button>
          </form>

          <div
            data-form-success
            hidden
            tabindex="-1"
            class="rounded-sm border border-mist bg-sand-soft p-8"
          >
            <h2 class="text-display-sm">Votre demande a bien été envoyée.</h2>
            <p class="mt-4 font-body text-base leading-relaxed text-anthracite/80">
              Merci pour ces informations. Studio VM revient vers vous sous quelques jours pour
              échanger sur votre projet.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-4 lg:col-start-9">
          <div class="flex flex-col gap-10">
            <div>
              <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-graphite">Écrire directement</p>
              <a href={`mailto:${SITE.email}`} class="mt-3 block font-display text-xl font-semibold">
                {SITE.email}
              </a>
            </div>
            <div>
              <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-graphite">Basé à</p>
              <p class="mt-3 font-body text-base text-anthracite/80">{SITE.locality}</p>
            </div>
            <div>
              <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-graphite">Délai de réponse</p>
              <p class="mt-3 font-body text-base text-anthracite/80">Sous quelques jours ouvrés.</p>
            </div>
          </div>
        </aside>
      </div>
    </Container>
  </Section>
</Layout>
