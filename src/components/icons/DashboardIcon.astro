---
type Name = 'overview' | 'sites' | 'stock' | 'clients' | 'automations' | 'search' | 'bell';

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className = 'h-3.5 w-3.5' } = Astro.props;
---
<svg viewBox="0 0 16 16" fill="none" class={className} aria-hidden="true" focusable="false">
  {
    name === 'overview' && (
      <g fill="currentColor">
        <rect x="2" y="2" width="5" height="5" rx="1" />
        <rect x="9" y="2" width="5" height="5" rx="1" />
        <rect x="2" y="9" width="5" height="5" rx="1" />
        <rect x="9" y="9" width="5" height="5" rx="1" />
      </g>
    )
  }
  {
    name === 'sites' && (
      <g stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
        <path d="M8 1.6c-2.1 0-3.8 1.7-3.8 3.8 0 2.8 3.8 6.6 3.8 6.6s3.8-3.8 3.8-6.6c0-2.1-1.7-3.8-3.8-3.8z" />
        <circle cx="8" cy="5.4" r="1.3" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    name === 'stock' && (
      <g stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M2.5 5.3 8 2.5l5.5 2.8L8 8.1z" />
        <path d="M2.5 5.3v5.9L8 14l5.5-2.8V5.3" />
        <path d="M8 8.1V14" />
      </g>
    )
  }
  {
    name === 'clients' && (
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="8" cy="5.3" r="2.4" />
        <path d="M3.2 13.8c0-2.6 2.1-4.7 4.8-4.7s4.8 2.1 4.8 4.7" />
      </g>
    )
  }
  {
    name === 'automations' && <path d="M9 1.6 3.6 9h3.2L6 14.4 12.4 7H9.2z" fill="currentColor" />
  }
  {
    name === 'search' && (
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
        <circle cx="6.6" cy="6.6" r="3.8" />
        <path d="M9.5 9.5 13 13" />
      </g>
    )
  }
  {
    name === 'bell' && (
      <g stroke="currentColor" stroke-width="1.15" stroke-linejoin="round" stroke-linecap="round">
        <path d="M8 2.3c-1.8 0-3.3 1.5-3.3 3.3v1.9c0 .5-.2 1-.5 1.4l-.6.8c-.4.5 0 1.2.6 1.2h7.6c.6 0 1-.7.6-1.2l-.6-.8c-.3-.4-.5-.9-.5-1.4V5.6c0-1.8-1.5-3.3-3.3-3.3z" />
        <path d="M6.6 12.9a1.4 1.4 0 0 0 2.8 0" />
      </g>
    )
  }
</svg>
