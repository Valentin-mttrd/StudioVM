---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { PROCESS_STEPS } from '../../data/process';
---
<Section tone="paper">
  <Container>
    <Eyebrow>Notre méthode</Eyebrow>
    <h2 class="mt-5 max-w-2xl text-display-lg" data-reveal>De l'idée à la solution.</h2>

    <ol class="relative mt-20 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
      <div class="absolute inset-x-0 top-6 hidden h-px bg-mist lg:block" aria-hidden="true"></div>
      {
        PROCESS_STEPS.map((step) => (
          <li class="relative flex flex-col" data-reveal data-reveal-group="process">
            <span class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border border-ink bg-paper font-display text-sm font-semibold">
              {step.index}
            </span>
            <h3 class="mt-6 text-display-sm">{step.title}</h3>
            <p class="mt-3 max-w-xs font-body text-base leading-relaxed text-anthracite/75">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
