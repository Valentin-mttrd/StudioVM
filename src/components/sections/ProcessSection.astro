---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { PROCESS_STEPS } from '../../data/process';
---
<Section tone="paper">
  <Container>
    <Eyebrow>Notre méthode</Eyebrow>
    <h2 class="[&_strong]:block mt-6 max-w-2xl text-display-lg" data-reveal data-reveal-mode="wave">
      De l'idée <strong>à la solution.</strong>
    </h2>

    <!-- A liquid line runs through the four steps as you scroll (process-progress.ts);
         each droplet fills with water once it has been reached. -->
    <ol class="relative mt-20 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:mt-24 lg:grid-cols-4" data-process>
      <div class="absolute inset-x-0 top-7 hidden h-[3px] rounded-full bg-ink/[0.06] lg:block" aria-hidden="true"></div>
      <div class="process-flow absolute inset-x-0 top-7 hidden h-[3px] origin-left scale-x-0 rounded-full lg:block" data-process-fill aria-hidden="true"></div>
      {
        PROCESS_STEPS.map((step) => (
          <li class="relative flex flex-col" data-reveal data-reveal-mode="rise" data-reveal-group="process" data-process-step data-filled="false">
            <span class="process-drop glass-light relative z-10 flex h-14 w-14 items-center justify-center overflow-hidden rounded-full font-display text-sm font-semibold">
              <span class="process-drop__water" aria-hidden="true"></span>
              <span class="relative">{step.index}</span>
            </span>
            <h3 class="mt-7 text-display-sm">{step.title}</h3>
            <p class="mt-3 max-w-xs font-body text-base font-light leading-relaxed text-anthracite/75">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>

<style>
  .process-flow {
    background: linear-gradient(90deg, var(--color-accent-soft), var(--color-accent) 70%, var(--color-tide));
    box-shadow: 0 0 14px rgb(70 96 122 / 0.35);
    transition: transform 0.2s linear;
  }

  .process-drop {
    transition:
      color var(--duration-moderate) var(--ease-out),
      scale var(--duration-flow) var(--ease-spring);
  }

  .process-drop__water {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, var(--color-accent), var(--color-tide));
    clip-path: circle(0% at 50% 100%);
    transition: clip-path 1s var(--ease-liquid);
  }

  [data-filled='true'] .process-drop {
    color: var(--color-paper);
    scale: 1.06;
  }

  [data-filled='true'] .process-drop__water {
    clip-path: circle(150% at 50% 100%);
  }
</style>
