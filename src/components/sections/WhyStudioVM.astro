---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { DIFFERENTIATORS } from '../../data/differentiators';
---
<Section tone="ink">
  <Container>
    <div class="lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <Eyebrow invert>Pourquoi Studio VM</Eyebrow>
        <h2 class="[&_strong]:block mt-6 max-w-md text-display-lg text-paper" data-reveal data-reveal-mode="wave">
          Une approche différente, <strong>pensée pour être utile.</strong>
        </h2>

        <!-- Scroll-spy numeral (src/scripts/sticky-counter.ts): an outline that
             fills with water as you move through the four points. -->
        <div class="mt-14 hidden lg:sticky lg:top-36 lg:block" aria-hidden="true">
          <span data-counter-display class="counter-liquid block font-display text-[8.5rem] font-extralight leading-none tracking-[-0.05em]">01</span>
          <span class="mt-4 block font-body text-[0.68rem] font-semibold uppercase tracking-[0.3em] text-ash">
            Sur {String(DIFFERENTIATORS.length).padStart(2, '0')}
          </span>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-8 lg:mt-2">
        {
          DIFFERENTIATORS.map((item, index) => (
            <article
              class="glass glass-hover glass-lift flex min-h-[15rem] flex-col justify-between overflow-hidden px-7 pt-7 pb-[calc(var(--level)+1.5rem)] sm:px-8 sm:pt-8"
              data-sheen
              data-reveal
              data-reveal-mode="rise"
              data-reveal-group="why"
              data-counter-item
              data-counter-index={String(index + 1).padStart(2, '0')}
              style={`--level: ${26 + index * 7}px`}
            >
              <span class="glass-water" aria-hidden="true" />
              <span class="font-display text-sm font-semibold text-accent-soft">{String(index + 1).padStart(2, '0')}</span>
              <div class="mt-10">
                <h3 class="text-display-sm text-paper">{item.title}</h3>
                <p class="mt-3 max-w-sm font-body text-base font-light leading-relaxed text-mist">{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</Section>

<style>
  @property --fill {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  /* Outline numeral + a liquid fill rising inside the glyphs. */
  .counter-liquid {
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.32);
    background: linear-gradient(to top, rgb(174 189 201 / 0.34) 0 var(--fill), transparent var(--fill));
    -webkit-background-clip: text;
    background-clip: text;
    transition:
      --fill var(--duration-tide) var(--ease-spring-soft),
      opacity 0.15s var(--ease-out);
  }

  /* The water sits in the card's bottom padding (sized from --level), so it
     never runs through the text; hovering tips a little more in. */
  .glass:hover :global(.glass-water) {
    height: calc(var(--level) + 12px);
  }
</style>
