---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { DIFFERENTIATORS } from '../../data/differentiators';
---
<Section tone="ink">
  <Container>
    <div class="lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <Eyebrow invert>Pourquoi Studio VM</Eyebrow>
        <h2 class="mt-5 max-w-md text-display-lg text-paper" data-reveal>
          Une approche différente, pensée pour être utile.
        </h2>

        <div class="mt-14 hidden lg:sticky lg:top-32 lg:block">
          <span
            data-counter-display
            class="block font-display text-[7rem] font-bold leading-none tracking-tight text-transparent transition-opacity duration-150 [-webkit-text-stroke:1px_rgba(255,255,255,0.35)]"
          >
            01
          </span>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-x-12 gap-y-14 sm:grid-cols-2 lg:col-span-8 lg:mt-0">
        {
          DIFFERENTIATORS.map((item, index) => (
            <div
              class="border-t border-paper/15 pt-6"
              data-reveal
              data-reveal-group="why"
              data-counter-item
              data-counter-index={String(index + 1).padStart(2, '0')}
            >
              <span class="font-display text-sm font-semibold text-ash lg:hidden">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-display-sm text-paper lg:mt-0">{item.title}</h3>
              <p class="mt-3 max-w-sm font-body text-base leading-relaxed text-mist">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Section>
