---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import DashboardPreview from '../portfolio/DashboardPreview.astro';
import webMockup from '../../assets/services/web-mockup.webp';
import { SERVICES } from '../../data/services';
---
<Section tone="paper" id="services-overview">
  <Container>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow>Nos expertises</Eyebrow>
        <h2 class="[&_strong]:block mt-6 text-display-lg" data-reveal data-reveal-mode="wave">
          Trois expertises, <strong>une seule vision.</strong>
        </h2>
      </div>
      <p class="max-w-md font-body text-lg font-light leading-relaxed text-anthracite/80 lg:col-span-5 lg:justify-self-end" data-reveal data-reveal-delay="120">
        Concevoir aujourd'hui les solutions de demain, en réunissant conception, technologie et
        visualisation dans une même approche.
      </p>
    </div>

    <div class="mt-20 flex flex-col lg:mt-28">
      {
        SERVICES.map((service, index) => (
          <article class="grid grid-cols-1 items-center gap-10 border-t border-ink/10 py-16 first:border-t-0 first:pt-0 last:pb-0 lg:grid-cols-12 lg:gap-12 lg:py-24">
            <div class:list={['flex flex-col justify-center lg:col-span-5', index % 2 === 1 && 'lg:order-2 lg:col-start-8']}>
              <div class="flex items-center gap-4" data-reveal data-reveal-fast>
                <span class="font-display text-sm font-semibold text-accent">{service.index}</span>
                <span class="h-px w-10 bg-ink/15" aria-hidden="true" />
                <span class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-graphite">Expertise</span>
              </div>
              <h3 class="mt-6 text-display-md" data-reveal>{service.title}</h3>
              <p class="mt-5 max-w-md font-body text-lg font-light leading-relaxed text-anthracite/80" data-reveal data-reveal-delay="80">{service.short}</p>
              <ul class="mt-7 flex flex-wrap gap-2" data-reveal data-reveal-fast data-reveal-delay="140">
                {service.bullets.slice(0, 5).map((bullet) => (
                  <li class="chip chip-hover">{bullet}</li>
                ))}
              </ul>
              <div data-reveal data-reveal-fast data-reveal-delay="200">
                <Button href={`/services#${service.id}`} variant="text" class="mt-9 w-fit">
                  En savoir plus
                </Button>
              </div>
            </div>
            <div class:list={['lg:col-span-7', index % 2 === 1 && 'lg:order-1 lg:col-start-1']} data-fluid>
              {service.id === 'web' ? (
                <Image
                  src={webMockup}
                  alt="Illustration d'un site vitrine affiché sur un ordinateur portable et un smartphone"
                  widths={[640, 960, 1400]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  quality={90}
                  class="w-full"
                  data-reveal
                  data-reveal-mode="scale"
                  data-reveal-delay="100"
                />
              ) : service.id === '3d' ? (
                <img
                  src="/images/services/3d-render.webp"
                  alt="Rendu 3D architectural d'une villa avec piscine et terrasse"
                  loading="lazy"
                  decoding="async"
                  width="2000"
                  height="1125"
                  class="w-full drop-shadow-[0_40px_50px_rgba(18,21,24,0.28)]"
                  data-reveal
                  data-reveal-mode="scale"
                  data-reveal-delay="100"
                />
              ) : (
                <DashboardPreview />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</Section>
