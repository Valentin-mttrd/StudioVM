---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import AbstractCover from '../portfolio/AbstractCover.astro';
import webMockup from '../../assets/services/web-mockup.webp';
import { SERVICES } from '../../data/services';

const coverTones: Record<string, 'sand' | 'anthracite' | 'ink'> = {
  web: 'sand',
  applications: 'anthracite',
  '3d': 'ink',
};
---
<Section tone="paper" id="services-overview">
  <Container>
    <div class="max-w-2xl">
      <Eyebrow>Nos expertises</Eyebrow>
      <h2 class="mt-5 text-display-lg" data-reveal>Trois expertises, une seule vision.</h2>
      <p class="mt-6 max-w-xl font-body text-lg text-anthracite/80" data-reveal data-reveal-delay="100">
        Concevoir aujourd'hui les solutions de demain, en réunissant conception, technologie et
        visualisation dans une même approche.
      </p>
    </div>

    <div class="mt-20 flex flex-col divide-y divide-mist">
      {
        SERVICES.map((service, index) => (
          <article class="grid grid-cols-1 gap-10 py-16 first:pt-0 last:pb-0 lg:grid-cols-12 lg:gap-12" data-reveal>
            <div class:list={['flex flex-col justify-center lg:col-span-5', index % 2 === 1 && 'lg:order-2']}>
              <span class="font-display text-sm font-semibold text-graphite">{service.index}</span>
              <h3 class="mt-4 text-display-sm">{service.title}</h3>
              <p class="mt-4 font-body text-base leading-relaxed text-anthracite/80">{service.short}</p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {service.bullets.slice(0, 5).map((bullet) => (
                  <li class="rounded-sm border border-mist px-3 py-1.5 font-body text-xs text-anthracite/70">
                    {bullet}
                  </li>
                ))}
              </ul>
              <Button href={`/services#${service.id}`} variant="text" class="mt-8 w-fit">
                En savoir plus
              </Button>
            </div>
            <div class:list={['lg:col-span-7', service.id === 'web' && 'flex items-center', index % 2 === 1 && 'lg:order-1']}>
              {service.id === 'web' ? (
                <Image
                  src={webMockup}
                  alt="Illustration d'un site vitrine affiché sur un ordinateur portable et un smartphone"
                  widths={[640, 960, 1400]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  quality={90}
                  class="w-full rounded-sm"
                  data-reveal
                  data-reveal-delay="100"
                />
              ) : (
                <AbstractCover
                  kind={service.id}
                  tone={coverTones[service.id]}
                  flip={index % 2 === 1}
                  class="aspect-[4/3] rounded-sm"
                />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</Section>
