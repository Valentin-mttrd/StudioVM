---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
---
<!-- Hero — a night pool seen from above (src/scripts/liquid: data-water="hero"
     adds the refracted tile grid and the villa's reflection). The headline is
     split into letters by src/scripts/kinetic-type.ts; the whole section is
     its pointer zone. -->
<section
  data-hero
  data-tone="ink"
  data-water="hero"
  data-kinetic-zone
  class="relative flex min-h-[100svh] flex-col overflow-hidden bg-ink text-paper"
>
  <!-- No-WebGL backdrop: the same tile grid, flat. Fades out once the water runs. -->
  <div class="liquid-fallback pointer-events-none absolute -inset-y-12 inset-x-0 select-none" data-parallax aria-hidden="true">
    <div
      class="absolute inset-0 opacity-[0.05]"
      style="background-image: linear-gradient(to right, var(--color-mist) 1px, transparent 1px), linear-gradient(to bottom, var(--color-mist) 1px, transparent 1px); background-size: 56px 56px;"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-ink/40"></div>
  </div>

  <!-- Floating glass droplets, at three depths (parallax.ts moves them by data-depth). -->
  <div class="pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
    <span class="hero-drop left-[58%] top-[16%] h-16 w-16 [animation-duration:17s]" data-depth="0.6"></span>
    <span class="hero-drop left-[91%] top-[64%] h-24 w-24 [animation-delay:-6s] [animation-duration:21s]" data-depth="1"></span>
    <span class="hero-drop left-[44%] top-[82%] h-9 w-9 [animation-delay:-11s] [animation-duration:15s]" data-depth="0.35"></span>
  </div>

  <Container class="relative z-[1] flex flex-1 flex-col justify-center pb-8 pt-28 sm:pt-32 lg:pb-10">
    <div class="relative">
      <div class="flex" data-reveal data-reveal-fast data-reveal-delay="120">
        <p class="chip chip-dark gap-3 py-2 pl-2.5 pr-4 font-semibold uppercase tracking-[0.24em] text-mist">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-paper/10">
            <Logo variant="mark" tone="light" markClass="h-2.5" />
          </span>
          Web · Applications · 3D
        </p>
      </div>

      <h1
        class="hero-title relative mt-7 max-w-[16ch] font-display font-light text-paper lg:max-w-none"
        data-kinetic
        data-kinetic-delay="380"
      >
        <span class="block">Des solutions digitales</span>
        <span class="block text-mist">pour donner <strong class="liquid-word" data-kinetic-keep>vie</strong></span>
        <span class="block">à vos projets.</span>
      </h1>

      <div class="relative mt-9 grid grid-cols-1 items-end gap-10 lg:mt-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p
            class="max-w-lg font-body text-lg font-light leading-relaxed text-mist sm:text-xl"
            data-reveal
            data-reveal-delay="950"
          >
            Création de sites web, d'applications sur mesure et de visualisations 3D — pensées pour
            votre activité.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4" data-reveal data-reveal-fast data-reveal-delay="1100">
            <Button href="/contact" variant="solid" invert data-magnetic="0.3">Parler de votre projet</Button>
            <Button href="/services" variant="outline" invert>Découvrir nos services</Button>
          </div>
        </div>

        <!-- The one concrete visual: a real 3D render, floating on the water
             with its reflection drawn beneath it by the WebGL engine
             (data-liquid-reflect). Decorative: the headline carries the
             message. -->
        <div class="pointer-events-none relative hidden lg:col-span-6 lg:block" aria-hidden="true">
          <div class="relative lg:-mt-36 xl:-mt-44 [perspective:1400px]">
            <div data-parallax-object class="will-change-transform">
              <div class="hero-object-float ml-auto w-full max-w-[32rem] xl:max-w-[38rem]">
                <img
                  src="/images/services/3d-render.webp"
                  alt=""
                  width="2000"
                  height="1125"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  data-liquid-reflect
                  data-reveal
                  data-reveal-mode="scale"
                  data-reveal-delay="650"
                  class="w-full drop-shadow-[0_60px_70px_rgba(0,0,0,0.55)]"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <div class="relative z-[1] pb-7 sm:pb-9">
    <Container class="flex items-end justify-between gap-6 text-ash">
      <div class="hero-late flex items-center gap-4" style="--late: 1.3s">
        <span class="scroll-drop" aria-hidden="true"><i></i></span>
        <span class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.3em]">Défiler</span>
      </div>
      <p class="hero-late hidden font-body text-[0.68rem] font-semibold uppercase tracking-[0.3em] sm:block" style="--late: 1.45s">
        Lorient, Bretagne <span class="mx-2 text-graphite">/</span> 47°44′ N — 3°22′ O
      </p>
    </Container>
  </div>

  <!-- No-WebGL seam into the next section (the water draws a live waterline instead). -->
  <div class="liquid-fallback pointer-events-none absolute inset-x-0 bottom-0 text-paper" aria-hidden="true">
    <svg viewBox="0 0 1440 72" preserveAspectRatio="none" class="h-10 w-full sm:h-14">
      <path d="M0,0 C 360,72 1080,72 1440,0 L1440,72 L0,72 Z" fill="currentColor" />
    </svg>
  </div>
</section>

<style>
  /* Headline — the largest thing on the site. Light cut, tight tracking,
     one bold liquid word. Sized so "Des solutions digitales" holds one line
     inside the 90rem container on desktop. */
  .hero-title {
    font-size: clamp(2.8rem, 0.8rem + 7.3vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.048em;
  }

  .hero-title :global(strong) {
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  /* Glass droplets drifting at different depths. */
  .hero-drop {
    position: absolute;
    border-radius: 50%;
    /* A drop of water on dark water: nearly clear, a hard specular up-left,
       the light it focuses pooling as a crescent down-right, a bright rim. */
    background:
      radial-gradient(circle at 31% 25%, rgb(255 255 255 / 0.85) 0 3.5%, rgb(255 255 255 / 0.14) 11%, transparent 28%),
      radial-gradient(circle at 66% 78%, rgb(219 225 231 / 0.32), transparent 36%),
      radial-gradient(circle, transparent 60%, rgb(255 255 255 / 0.1) 80%, rgb(255 255 255 / 0.02) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      inset 0 -3px 8px rgb(174 189 201 / 0.12),
      0 14px 26px -18px rgb(0 0 0 / 0.55);
    opacity: 0;
    transition: opacity 1.6s var(--ease-out) 1.2s;
  }

  :global(html.liquid) .hero-drop {
    opacity: 1;
  }

  :global(html:is([data-liquid-tier='high'], [data-liquid-tier='medium'])) .hero-drop {
    -webkit-backdrop-filter: blur(1.5px) saturate(1.35);
    backdrop-filter: blur(1.5px) saturate(1.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-drop {
      animation: drop-drift 18s var(--ease-in-out) infinite;
    }
  }

  @keyframes drop-drift {
    0%, 100% { translate: 0 0; }
    33% { translate: 10px -22px; }
    66% { translate: -8px -8px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-object-float {
      animation: hero-float 9s var(--ease-in-out) infinite;
    }
  }

  @keyframes hero-float {
    0%, 100% { translate: 0 0; rotate: 0deg; }
    50% { translate: 0 -14px; rotate: -0.6deg; }
  }

  /* Items pinned to the bottom edge sit outside the reveal observer's
     trigger zone, so they enter on a timer instead. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-late {
      animation: hero-late 0.9s var(--ease-spring) var(--late, 1.2s) both;
    }
  }

  @keyframes hero-late {
    from { opacity: 0; translate: 0 0.75rem; }
    to { opacity: 1; translate: 0 0; }
  }

  /* Scroll cue: a drop that forms, falls and vanishes along a thread. */
  .scroll-drop {
    position: relative;
    display: block;
    width: 1px;
    height: 2.6rem;
    background: linear-gradient(to bottom, rgb(168 168 168 / 0.1), rgb(168 168 168 / 0.5));
  }

  .scroll-drop i {
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 7px;
    margin-left: -2.5px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--color-glint);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-drop i {
      animation: drop-fall 2.6s var(--ease-in-out) infinite;
    }
  }

  @keyframes drop-fall {
    0% { translate: 0 -4px; scale: 0.4; opacity: 0; }
    20% { translate: 0 0; scale: 1; opacity: 1; }
    70% { translate: 0 2.2rem; scale: 0.9 1.15; opacity: 1; }
    100% { translate: 0 2.4rem; scale: 1.6 0.2; opacity: 0; }
  }
</style>
