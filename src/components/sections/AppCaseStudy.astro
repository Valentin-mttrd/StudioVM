---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import StockChantierMockup from '../portfolio/StockChantierMockup.astro';

const features = [
  { title: 'Gestion du stock', description: 'Suivi des quantités disponibles, en temps réel.' },
  { title: 'Gestion des chantiers', description: 'Chaque chantier centralise son matériel et ses besoins.' },
  { title: 'Mouvements de stock', description: 'Entrées, sorties et transferts tracés automatiquement.' },
  { title: 'Nomenclatures', description: 'Des listes de matériel type, réutilisables par chantier.' },
  { title: 'Calcul des besoins', description: 'Le nécessaire pour un chantier déterminé en un clic.' },
  { title: 'Préparation de chantier', description: 'Une liste de préparation générée automatiquement.' },
  { title: 'Historique', description: 'Un suivi complet et daté de toutes les opérations.' },
  { title: 'Tableaux de bord', description: "Une vue d'ensemble claire de l'activité." },
];
---
<Section tone="sand" id="etude-de-cas">
  <Container>
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="flex flex-col items-start lg:col-span-5">
        <Eyebrow>Étude de cas — Applications</Eyebrow>
        <h2 class="[&_strong]:block mt-6 text-display-lg" data-reveal data-reveal-mode="wave">
          Un processus métier complexe, <strong>devenu un outil simple.</strong>
        </h2>
        <p class="mt-7 font-body text-lg font-light leading-relaxed text-anthracite/80" data-reveal data-reveal-delay="100">
          Studio VM a conçu un outil de gestion de stock et de préparation de chantier pour
          remplacer les fichiers dispersés et le suivi manuel par une plateforme centralisée et
          automatisée.
        </p>
        <span class="chip mt-7 font-semibold uppercase tracking-[0.18em] text-anthracite" data-reveal data-reveal-fast data-reveal-delay="150">
          <span class="live-dot h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Démonstration
        </span>

        <div data-reveal data-reveal-fast data-reveal-delay="200">
          <Button href="/realisations/stock-chantier" variant="text" class="mt-10 w-fit">
            Voir l'étude de cas complète
          </Button>
        </div>
      </div>

      <div class="lg:col-span-7 lg:pl-6" data-fluid="0.8">
        <div data-reveal data-reveal-mode="rise" data-reveal-delay="120">
          <StockChantierMockup />
        </div>
      </div>
    </div>

    <ul class="mt-24 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:mt-28 lg:grid-cols-4">
      {
        features.map((feature, index) => (
          <li
            class="glass-light glass-hover glass-lift rounded-[20px] p-6"
            data-sheen
            data-reveal
            data-reveal-mode="rise"
            data-reveal-group="app-features"
          >
            <span class="font-display text-xs font-semibold text-accent">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 font-display text-base font-semibold">{feature.title}</h3>
            <p class="mt-2 font-body text-sm font-light leading-relaxed text-anthracite/75">{feature.description}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
