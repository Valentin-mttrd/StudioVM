---
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { NAV_LINKS, PRIMARY_CTA, FOOTER_LEGAL_LINKS } from '../../data/nav';
import { SERVICES } from '../../data/services';
import { SITE } from '../../lib/constants';

const year = new Date().getFullYear();
const linkClass = 'group relative inline-flex items-center font-body text-sm text-mist transition-colors duration-300 hover:text-paper';
---
<!-- The abyss: the deepest, darkest water on the site. -->
<footer data-tone="ink" data-water="abyss" class="overflow-hidden bg-ink text-paper">
  <Container class="pb-20 pt-28 sm:pb-24 sm:pt-36">
    <div class="flex flex-col items-start justify-between gap-12 lg:flex-row lg:items-end">
      <div>
        <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.3em] text-ash" data-reveal data-reveal-fast>Contact</p>
        <h2 class="[&_strong]:block mt-6 max-w-3xl text-display-lg text-paper" data-reveal data-reveal-mode="wave">
          Un projet en tête&nbsp;? <strong>Parlons-en.</strong>
        </h2>
      </div>
      <div data-reveal data-reveal-fast data-reveal-delay="160">
        <Button href={PRIMARY_CTA.href} variant="solid" invert data-magnetic="0.3">
          {PRIMARY_CTA.label}
        </Button>
      </div>
    </div>
  </Container>

  <Container class="grid grid-cols-2 gap-x-8 gap-y-14 border-t border-paper/10 py-16 sm:py-20 lg:grid-cols-12">
    <div class="col-span-2 lg:col-span-4">
      <Logo variant="full" tone="light" markClass="h-7" class="text-lg" />
      <p class="mt-6 max-w-xs font-body text-sm font-light leading-relaxed text-mist">{SITE.tagline}</p>
    </div>

    <nav class="col-span-1 lg:col-span-2 lg:col-start-7" aria-label="Expertises">
      <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ash">Expertises</p>
      <ul class="mt-5 space-y-3">
        {
          SERVICES.map((s) => (
            <li>
              <a href={`/services#${s.id}`} class={linkClass}>
                <span class="absolute -left-5 top-1/2 h-px w-3 origin-right scale-x-0 bg-current transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-x-100" aria-hidden="true" />
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="col-span-1 lg:col-span-2" aria-label="Navigation">
      <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ash">Navigation</p>
      <ul class="mt-5 space-y-3">
        {
          [...NAV_LINKS, { label: 'Contact', href: '/contact' }].map((l) => (
            <li>
              <a href={l.href} class={linkClass}>
                <span class="absolute -left-5 top-1/2 h-px w-3 origin-right scale-x-0 bg-current transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-x-100" aria-hidden="true" />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="col-span-2 lg:col-span-3">
      <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ash">Contact</p>
      <ul class="mt-5 space-y-3 font-body text-sm text-mist">
        <li>
          <a href={`mailto:${SITE.email}`} class={linkClass}>
            <span class="absolute -left-5 top-1/2 h-px w-3 origin-right scale-x-0 bg-current transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-x-100" aria-hidden="true" />
            {SITE.email}
          </a>
        </li>
        <li>{SITE.locality}</li>
        <li class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ash">47°44′ N — 3°22′ O</li>
      </ul>
    </div>
  </Container>

  <Container class="flex flex-col-reverse items-start gap-4 border-t border-paper/10 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-body text-xs text-ash">© {year} {SITE.name}. Tous droits réservés.</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        FOOTER_LEGAL_LINKS.map((l) => (
          <li>
            <a href={l.href} class="font-body text-xs text-ash transition-colors duration-200 hover:text-mist">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>

  <!-- Signature: the wordmark at the bottom of the deep, drawn in light on water. -->
  <p class="footer-mark pointer-events-none select-none px-3 text-center font-display leading-[0.8]" aria-hidden="true">
    <span class="font-extralight">STUDIO</span><span class="font-bold">VM</span>
  </p>
</footer>

<style>
  .footer-mark {
    margin-bottom: -0.12em;
    font-size: clamp(4.5rem, 19.5vw, 20rem);
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(219 225 231 / 0.12);
    background: linear-gradient(to top, rgb(174 189 201 / 0.1), transparent 70%);
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
