---
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import ArrowIcon from '../icons/ArrowIcon.astro';
import MenuIcon from '../icons/MenuIcon.astro';
import CloseIcon from '../icons/CloseIcon.astro';
import { NAV_LINKS, PRIMARY_CTA } from '../../data/nav';
import { SITE } from '../../lib/constants';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<a
  href="#main-content"
  class="fixed left-4 top-4 z-[60] -translate-y-24 bg-ink px-4 py-3 font-body text-sm font-semibold text-paper transition-transform duration-200 focus-visible:translate-y-0"
>
  Aller au contenu principal
</a>

<header
  data-nav
  data-solid="false"
  data-hidden="false"
  class="group/nav fixed inset-x-0 top-0 z-50 border-b border-transparent bg-paper/0 data-[solid=true]:border-mist data-[solid=true]:bg-paper/95 data-[solid=true]:backdrop-blur-md"
>
  <Container class="flex h-20 items-center justify-between lg:h-24">
    <a href="/" class="relative z-10 shrink-0" aria-label={`${SITE.name} — Accueil`}>
      <Logo variant="lockup" tone="nav" markClass="h-6 lg:h-7" class="text-[0.95rem] lg:text-base" />
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Navigation principale">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'relative font-body text-sm font-medium uppercase tracking-wide text-paper/85 transition-colors duration-500 hover:text-paper group-data-[solid=true]/nav:text-ink/75 group-data-[solid=true]/nav:hover:text-ink',
              currentPath === link.href &&
                'text-paper group-data-[solid=true]/nav:text-ink after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-full after:bg-current',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={PRIMARY_CTA.href}
      class="group hidden items-center gap-2.5 whitespace-nowrap rounded-sm border border-paper/40 px-6 py-3.5 font-body text-sm font-semibold uppercase tracking-[0.08em] text-paper transition-colors duration-500 hover:border-paper hover:bg-paper/10 group-data-[solid=true]/nav:border-ink/25 group-data-[solid=true]/nav:text-ink group-data-[solid=true]/nav:hover:border-ink group-data-[solid=true]/nav:hover:bg-ink/5 lg:inline-flex"
    >
      {PRIMARY_CTA.label}
      <ArrowIcon class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-1" />
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu"
      class="relative z-10 -mr-2 inline-flex h-11 w-11 items-center justify-center text-paper transition-colors duration-500 group-data-[solid=true]/nav:text-ink lg:hidden"
    >
      <MenuIcon class="h-6 w-6 [html.menu-open_&]:hidden" />
      <CloseIcon class="hidden h-6 w-6 [html.menu-open_&]:block" />
    </button>
  </Container>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  inert
  class="fixed inset-0 z-40 flex -translate-y-3 flex-col bg-ink text-paper opacity-0 pointer-events-none transition-[opacity,transform] duration-300 ease-out [html.menu-open_&]:pointer-events-auto [html.menu-open_&]:translate-y-0 [html.menu-open_&]:opacity-100 lg:hidden"
>
  <div class="flex h-full flex-col justify-between px-6 pb-10 pt-28 sm:px-10">
    <nav class="flex flex-col" aria-label="Navigation mobile">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath === link.href ? 'page' : undefined}
            class:list={[
              'flex items-center gap-3 border-b border-paper/15 py-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl',
              currentPath === link.href && 'text-mist',
            ]}
          >
            {link.label}
            {currentPath === link.href && <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true" />}
          </a>
        ))
      }
      <a
        href={PRIMARY_CTA.href}
        class="py-4 font-display text-3xl font-semibold tracking-tight text-mist sm:text-4xl"
      >
        {PRIMARY_CTA.label}
      </a>
    </nav>

    <div class="flex flex-col gap-1 font-body text-sm text-mist">
      <a href={`mailto:${SITE.email}`} class="w-fit">{SITE.email}</a>
      <p>{SITE.locality}</p>
    </div>
  </div>
</div>
