---
type Tone = 'paper' | 'sand' | 'ink' | 'anthracite';

interface Props {
  tone?: Tone;
  class?: string;
  id?: string;
  bleed?: boolean;
}

const { tone = 'paper', class: className = '', id, bleed = false } = Astro.props;

const toneClasses: Record<Tone, string> = {
  paper: 'bg-paper text-ink',
  sand: 'bg-sand text-ink',
  ink: 'bg-ink text-paper',
  anthracite: 'bg-anthracite text-paper',
};
---
<section
  id={id}
  data-tone={tone}
  class:list={[
    'relative',
    !bleed && 'py-24 sm:py-28 lg:py-36',
    toneClasses[tone],
    className,
  ]}
>
  <slot />
</section>
