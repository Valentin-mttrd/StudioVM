---
import ArrowIcon from '../icons/ArrowIcon.astro';
import { splitLabel } from '../../lib/split';

/**
 * Liquid button. See global.css (".lbtn", ".tlink") for every state and
 * src/scripts/liquid-button.ts for the pointer physics.
 *
 *   solid    filled capsule — primary action
 *   outline  glass capsule  — secondary action
 *   text     inline link whose underline turns to a flowing wave
 *
 * Add data-magnetic (optionally ="0.3") to let the pointer pull it.
 */
type Variant = 'solid' | 'outline' | 'text';

interface Props {
  href?: string;
  variant?: Variant;
  invert?: boolean;
  class?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
  disabled?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = 'solid',
  invert = false,
  class: className = '',
  type = 'button',
  arrow = true,
  disabled = false,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const html = await Astro.slots.render('default');
// Letter-split labels roll on hover; the visible letters ARE the accessible
// text (the rolling copy is CSS generated content with empty alt text), so
// screen readers and crawlers get the label exactly once.
const words = variant === 'text' ? null : splitLabel(html);
let index = 0;
---
{
  variant === 'text' ? (
    <Tag
      href={href}
      type={!href ? type : undefined}
      disabled={!href ? disabled : undefined}
      aria-disabled={href && disabled ? 'true' : undefined}
      class:list={['tlink', invert ? 'text-paper' : 'text-ink', className]}
      {...rest}
    >
      <span set:html={html} />
      {arrow && (
        <span class="tlink__icon" aria-hidden="true">
          <ArrowIcon class="h-3.5 w-3.5 shrink-0" />
        </span>
      )}
      <span class="tlink__line" aria-hidden="true" />
    </Tag>
  ) : (
    <Tag
      href={href}
      type={!href ? type : undefined}
      disabled={!href ? disabled : undefined}
      aria-disabled={href && disabled ? 'true' : undefined}
      class:list={['lbtn', `lbtn--${variant}`, invert && 'lbtn--invert', className]}
      data-liquid-btn
      {...rest}
    >
      <span class="lbtn__body">
        <span class="lbtn__blob" aria-hidden="true" />
        <span class="lbtn__sheen" aria-hidden="true" />
        <span class="lbtn__wave" aria-hidden="true" />
        <span class="lbtn__ring" aria-hidden="true" />
        <span class="lbtn__label">
          {words ? (
            words.map((word, wordIndex) => (
              <>
                <span class="lbtn__w">
                  {word.map((char) => (
                    <span class="lbtn__c" data-c={char} style={`--i:${index++}`}>
                      {char}
                    </span>
                  ))}
                </span>
                {wordIndex < words.length - 1 && ' '}
              </>
            ))
          ) : (
            <Fragment set:html={html} />
          )}
        </span>
        {arrow && (
          <span class="lbtn__icon" aria-hidden="true">
            <ArrowIcon class="h-3.5 w-3.5 shrink-0" />
            <ArrowIcon class="h-3.5 w-3.5 shrink-0" />
          </span>
        )}
        <span class="lbtn__bubbles" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
      </span>
    </Tag>
  )
}
