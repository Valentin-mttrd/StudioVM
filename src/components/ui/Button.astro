---
import ArrowIcon from '../icons/ArrowIcon.astro';

type Variant = 'solid' | 'outline' | 'text';

interface Props {
  href?: string;
  variant?: Variant;
  invert?: boolean;
  class?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
  disabled?: boolean;
}

const {
  href,
  variant = 'solid',
  invert = false,
  class: className = '',
  type = 'button',
  arrow = true,
  disabled = false,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const base =
  'btn-motion group relative inline-flex items-center justify-center gap-2.5 whitespace-nowrap rounded-sm font-body text-sm font-semibold uppercase tracking-[0.08em] active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 disabled:active:scale-100 disabled:data-[loading=true]:cursor-progress disabled:data-[loading=true]:opacity-100';

const variants: Record<Variant, string> = {
  solid: invert
    ? 'bg-paper text-ink px-7 py-4 hover:bg-sand'
    : 'bg-ink text-paper px-7 py-4 hover:bg-anthracite',
  outline: invert
    ? 'border border-paper/40 text-paper px-7 py-4 hover:border-paper hover:bg-paper/10'
    : 'border border-ink/25 text-ink px-7 py-4 hover:border-ink hover:bg-ink/5',
  text: `px-0 py-1 ${invert ? 'text-paper' : 'text-ink'}`,
};

const labelClasses =
  variant === 'text'
    ? 'relative after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out group-hover:after:scale-x-100'
    : '';
---
<Tag
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  class:list={[base, variants[variant], className]}
  {...rest}
>
  <span
    class:list={[labelClasses, 'transition-opacity duration-150 ease-out group-data-[loading=true]:opacity-70']}
  >
    <slot />
  </span>
  {arrow && (
    <ArrowIcon class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-1 group-data-[loading=true]:hidden" />
  )}
  <svg
    class="hidden h-3.5 w-3.5 shrink-0 animate-spin group-data-[loading=true]:block"
    viewBox="0 0 16 16"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5" opacity="0.25" />
    <path d="M14.5 8a6.5 6.5 0 0 0-6.5-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</Tag>
