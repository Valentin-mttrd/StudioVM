---
/**
 * Coded UI mockup standing in for real product screenshots (see brief §26 —
 * nothing here represents real client data). Reused on the homepage teaser
 * and the full case study page.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['relative lg:min-h-[30rem]', className]}>
  <!-- Dashboard panel -->
  <div class="relative z-10 rounded-[18px] border border-ink/10 bg-paper p-5 shadow-[0_40px_70px_-34px_rgba(18,21,24,0.35)] lg:absolute lg:left-0 lg:top-0 lg:w-[86%]">
    <div class="flex items-center justify-between">
      <div class="h-2.5 w-24 rounded-full bg-ink/70"></div>
      <div class="flex gap-1.5">
        <span class="h-2 w-2 rounded-full bg-mist"></span>
        <span class="h-2 w-2 rounded-full bg-mist"></span>
        <span class="h-2 w-2 rounded-full bg-mist"></span>
      </div>
    </div>
    <div class="mt-5 grid grid-cols-3 gap-3">
      {
        ['Stock disponible', 'Chantiers actifs', 'Préparations'].map((label) => (
          <div class="rounded-[10px] border border-mist p-3">
            <div class="h-1.5 w-full max-w-14 rounded-full bg-ink/15" />
            <div class="mt-3 h-3 w-10 rounded-full bg-ink/70" />
            <p class="mt-2 truncate font-body text-[0.6rem] uppercase tracking-wide text-graphite">{label}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-4 flex h-24 items-end gap-2 rounded-[10px] border border-mist p-3">
      {
        [40, 70, 50, 90, 60, 80, 45].map((h, i) => (
          <span class:list={['w-full rounded-t-sm bg-ink', i === 3 ? 'opacity-70' : 'opacity-15']} style={`height:${h}%`} />
        ))
      }
    </div>
  </div>

  <!-- Stock list panel -->
  <div class="relative z-20 mt-4 w-[92%] rounded-[18px] border border-ink/10 bg-paper p-5 shadow-[0_40px_70px_-34px_rgba(18,21,24,0.4)] lg:absolute lg:left-[8%] lg:top-[48%] lg:mt-0 lg:w-[70%]">
    <div class="flex items-center justify-between">
      <div class="h-2.5 w-28 rounded-full bg-ink/70"></div>
      <div class="h-2 w-12 rounded-full bg-ink/15"></div>
    </div>
    <ul class="mt-4 flex flex-col divide-y divide-mist">
      {
        [
          { w: 'w-32', trend: 'up' },
          { w: 'w-24', trend: 'down' },
          { w: 'w-28', trend: 'up' },
        ].map((row) => (
          <li class="flex items-center justify-between py-2.5">
            <div class="flex items-center gap-2.5">
              <span class="h-2 w-2 rounded-full bg-accent/70" />
              <span class:list={['h-2 rounded-full bg-ink/25', row.w]} />
            </div>
            <span class:list={['h-2 w-10 rounded-full', row.trend === 'up' ? 'bg-ink/50' : 'bg-graphite/40']} />
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Preparation checklist panel -->
  <div class="relative z-30 -mt-6 ml-[14%] w-[80%] rounded-[18px] border border-paper/10 bg-deep p-5 text-paper shadow-[0_40px_70px_-30px_rgba(18,21,24,0.6)] lg:absolute lg:left-[30%] lg:top-[68%] lg:mt-0 lg:ml-0 lg:w-[62%]">
    <div class="flex items-center justify-between">
      <div class="h-2.5 w-24 rounded-full bg-paper/80"></div>
      <div class="h-1.5 w-16 overflow-hidden rounded-full bg-paper/15">
        <div class="h-full w-2/3 rounded-full bg-paper/70"></div>
      </div>
    </div>
    <ul class="mt-4 flex flex-col gap-2.5">
      {
        [true, true, false].map((checked) => (
          <li class="flex items-center gap-2.5">
            <span
              class:list={[
                'flex h-4 w-4 shrink-0 items-center justify-center rounded-[2px] border',
                checked ? 'border-paper bg-paper' : 'border-paper/40',
              ]}
            >
              {checked && (
                <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 text-ink">
                  <path
                    d="M2 6L5 9L10 3"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </span>
            <span class="h-2 w-28 rounded-full bg-paper/25" />
          </li>
        ))
      }
    </ul>
  </div>
</div>
