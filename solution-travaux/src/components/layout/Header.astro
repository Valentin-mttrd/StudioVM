---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { NAV, QUOTE_HREF, CALLBACK_HREF } from '../../data/nav';
import { SITE } from '../../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && href !== '/' && path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a href="/" class="site-header__brand">
      <Logo />
      <span class="sr-only">, accueil</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <ul role="list" class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={SITE.phone.href}>
        <Icon name="phone" size={18} />
        <span class="site-header__phone-number">{SITE.phone.display}</span>
        <span class="sr-only site-header__phone-sr">Appeler le {SITE.phone.display}</span>
      </a>
      <Button href={QUOTE_HREF} icon="arrow" class="site-header__cta">Demander un devis</Button>
      <button
        type="button"
        class="site-header__burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={22} />
        <span class="label">Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="menu on-ink" aria-label="Menu" data-menu>
  <div class="menu__inner">
    <div class="menu__top">
      <a href="/"><Logo tone="paper" /><span class="sr-only">, accueil</span></a>
      <button type="button" class="menu__close" data-menu-close>
        <Icon name="close" size={22} />
        <span class="label">Fermer</span>
      </button>
    </div>

    <nav aria-label="Navigation mobile" class="menu__nav">
      <ol role="list" class="menu__list">
        {
          [...NAV.slice(0, 5), { label: 'Demande de rappel', href: CALLBACK_HREF }, NAV[5]].map((item, i) => (
            <li style={`--i:${i}`}>
              <a class="menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="label menu__index">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="menu__contact">
      <a href={SITE.phone.href} class="menu__contact-line">
        <Icon name="phone" /> <span>{SITE.phone.display}</span>
      </a>
      <a href={SITE.mobile.href} class="menu__contact-line">
        <Icon name="mobile" /> <span>{SITE.mobile.display} <span class="muted">· {SITE.broker.displayName}</span></span>
      </a>
      <a href={`mailto:${SITE.email}`} class="menu__contact-line">
        <Icon name="mail" /> <span>{SITE.email}</span>
      </a>
      <Button href={QUOTE_HREF} icon="arrow" size="lg" block>Demander un devis</Button>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition:
      transform var(--dur-3) var(--ease-out),
      background-color var(--dur-2) ease,
      box-shadow var(--dur-2) ease;
  }

  .site-header.is-scrolled {
    background-color: rgb(243 240 233 / 0.86);
    box-shadow: 0 1px 0 var(--c-line);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .site-header__brand {
    text-decoration: none;
    flex: none;
  }

  .site-nav {
    display: none;
    margin-left: auto;
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1rem, 0.2rem + 1.2vw, 1.75rem);
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--s-2);
    font-size: 0.9375rem;
    font-weight: 560;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1.5px;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .site-nav__link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-left: auto;
  }

  .site-header__phone {
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
    font-weight: 620;
    font-size: 0.9375rem;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    border-radius: var(--r);
    transition: color var(--dur-1) ease;
  }

  @media (hover: hover) {
    .site-header__phone:hover {
      color: var(--c-accent);
    }
  }

  .site-header__phone-number {
    display: none;
  }

  .site-header__cta {
    display: none;
  }

  .site-header__burger {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r);
    background: transparent;
  }

  @media (min-width: 40rem) {
    .site-header__cta {
      display: inline-flex;
    }

    .site-header__phone {
      display: inline-flex;
    }
  }

  @media (min-width: 72rem) {
    .site-nav {
      display: block;
    }

    .site-header__actions {
      margin-left: var(--s-4);
    }

    .site-header__burger {
      display: none;
    }
  }

  @media (min-width: 90rem) {
    .site-header__phone-number {
      display: inline;
    }

    .site-header__phone-sr {
      display: none;
    }
  }

  /* ── Mobile menu ── */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-1.5%);
    transition:
      opacity var(--dur-2) ease,
      transform var(--dur-3) var(--ease-out),
      overlay var(--dur-2) allow-discrete,
      display var(--dur-2) allow-discrete;
  }

  .menu[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
      transform: translateY(-1.5%);
    }
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    padding: 0 var(--gutter) calc(var(--s-8) + env(safe-area-inset-bottom));
  }

  .menu__top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu__top a {
    text-decoration: none;
  }

  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-line-ink-strong);
    border-radius: var(--r);
    background: transparent;
    color: var(--c-on-ink);
  }

  .menu__list {
    display: grid;
  }

  .menu__list li {
    border-bottom: 1px solid var(--c-line-ink);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    font-size: clamp(1.625rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 680;
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
  }

  .menu__link[aria-current='page'] {
    color: var(--c-accent-soft);
  }

  .menu__index {
    color: var(--c-accent-soft);
    min-width: 2.5ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu__list li {
      animation: menu-in var(--dur-3) var(--ease-out) both;
      animation-delay: calc(80ms + var(--i) * 40ms);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .menu__contact {
    margin-top: auto;
    display: grid;
    gap: var(--s-3);
  }

  .menu__contact-line {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 2.75rem;
    text-decoration: none;
    font-weight: 560;
    overflow-wrap: anywhere;
  }

  .menu__contact :global(.btn) {
    margin-top: var(--s-3);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  // Smart header: tucks away while reading down, returns on the way up.
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 8);
      const goingDown = y > lastY + 4;
      const goingUp = y < lastY - 4;
      if (goingDown && y > 480 && !header.contains(document.activeElement)) header.classList.add('is-hidden');
      else if (goingUp || y < 480) header.classList.remove('is-hidden');
      if (goingDown || goingUp) lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
  }

  // Mobile menu: a native modal <dialog> gives focus trapping, Esc and an
  // inert page for free.
  if (menu && openBtn) {
    const setOpen = (open: boolean) => {
      if (open) {
        menu.showModal();
        document.documentElement.style.overflow = 'hidden';
      } else {
        menu.close();
      }
      openBtn.setAttribute('aria-expanded', String(open));
    };
    openBtn.addEventListener('click', () => setOpen(true));
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
    menu.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
    });
    // In-page anchors (/#methode) must close the menu before scrolling.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 72rem)').addEventListener('change', (e) => {
      if (e.matches && menu.open) setOpen(false);
    });
  }
</script>
