---
/**
 * Thumb-zone action bar on phones: the three ways to start a project are
 * always one tap away (call, get called back, send the project).
 */
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';
import { QUOTE_HREF, CALLBACK_HREF } from '../../data/nav';

const onCallback = Astro.url.pathname.startsWith(CALLBACK_HREF);
---
<nav class="mobile-bar" aria-label="Contact rapide">
  <a href={SITE.phone.href} class="mobile-bar__item">
    <Icon name="phone" size={20} />
    <span>Appeler</span>
  </a>
  <a href={CALLBACK_HREF} class="mobile-bar__item" aria-current={onCallback ? 'page' : undefined}>
    <Icon name="callback" size={20} />
    <span>Être rappelé</span>
  </a>
  <a href={QUOTE_HREF} class="mobile-bar__item mobile-bar__item--primary">
    <span>Demander un devis</span>
    <Icon name="arrow" size={18} />
  </a>
</nav>

<style>
  :global(:root) {
    --mobile-bar-h: calc(4rem + env(safe-area-inset-bottom));
  }

  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr 1.6fr;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-2) calc(var(--s-2) + env(safe-area-inset-bottom));
    background: rgb(20 28 33 / 0.94);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--c-on-ink);
    box-shadow: 0 -1px 0 rgb(255 255 255 / 0.06);
  }

  .mobile-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 3rem;
    border-radius: var(--r);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur-1) ease, transform var(--dur-1) var(--ease-out);
  }

  .mobile-bar__item:active {
    transform: scale(0.97);
    background: rgb(255 255 255 / 0.08);
  }

  .mobile-bar__item[aria-current='page'] {
    color: var(--c-accent-soft);
  }

  .mobile-bar__item--primary {
    flex-direction: row;
    gap: var(--s-2);
    background: var(--c-accent);
    color: var(--c-paper);
    font-size: 0.875rem;
  }

  .mobile-bar__item--primary:active {
    background: var(--c-accent-press);
  }

  @media (min-width: 48rem) {
    .mobile-bar {
      display: none;
    }

    :global(:root) {
      --mobile-bar-h: 0px;
    }
  }
</style>
