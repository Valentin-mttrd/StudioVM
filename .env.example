# Copy this file to `.env` and fill in real values to activate the contact
# form's email delivery (src/lib/mailer.ts). Works with any SMTP-compatible
# mailbox: the domain's own host (OVH, Infomaniak...), Gmail, or a
# transactional provider's SMTP interface (Resend, SendGrid, etc).
# Without these, the form still works end-to-end but tells visitors that
# automatic sending isn't configured yet and points them to a direct email.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" only if your provider requires implicit TLS (usually port 465).
SMTP_SECURE=false

# Defaults to contact@studiovm.fr (see src/lib/constants.ts) if unset.
CONTACT_TO_EMAIL=
