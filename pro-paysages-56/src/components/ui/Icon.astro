  lawn: '<path d="M3 20.5h18"/><path d="M6 20.5c0-3.6-.8-6.4-2.6-8.6"/><path d="M9.2 20.5c0-4.6.9-7.9 2.9-10.9"/><path d="M13.2 20.5c0-3.9 1.4-6.6 3.8-8.3"/><path d="M17.2 20.5c0-2.7.9-4.7 2.8-6"/>',
  flower:
    '<circle cx="12" cy="7.5" r="1.6"/><path d="M12 5.9c-1-2.1.6-3.4 0-3.4s1 1.3 0 3.4Z" /><path d="M12 5.9C11 3.8 9 3.6 9.3 5.5c.3 1.9 2.7 2 2.7 2M12 5.9c1-2.1 3-2.3 2.7-.4-.3 1.9-2.7 2-2.7 2M10.4 7.5c-2.2-.4-3.3 1.2-1.7 2.1 1.6.9 3.3-.5 3.3-.5M13.6 7.5c2.2-.4 3.3 1.2 1.7 2.1-1.6.9-3.3-.5-3.3-.5"/><path d="M12 9.1V21"/><path d="M12 16c-2.8 0-4.6-1.6-4.6-3.6 2.8 0 4.6 1.6 4.6 3.6ZM12 18.5c2.4 0 4-1.4 4-3.1-2.4 0-4 1.4-4 3.1Z"/>',
  water:
    '<path d="M12 21v-6.5"/><path d="M9 21h6"/><path d="M12 14.5C9.4 11.4 6.6 10 3.5 10"/><path d="M12 14.5c2.6-3.1 5.4-4.5 8.5-4.5"/><path d="M12 11.5c0-2.6.6-4.9 1.8-6.9"/><path d="M5 6.2v.01M8.5 4.6v.01M17 3.9v.01M19.8 6.3v.01"/>',
