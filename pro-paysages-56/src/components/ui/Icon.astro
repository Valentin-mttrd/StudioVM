---
/**
 * One line-icon set for the whole site: 24px grid, 1.5 stroke, round caps.
 * Service icons are drawn from the trade (pickets, bricks, slabs, blades…),
 * UI icons stay minimal.
 */
import type { IconName } from '../../data/site';

type UiIcon =
  | 'arrow'
  | 'arrow-down'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'clock'
  | 'check'
  | 'plus'
  | 'minus'
  | 'close'
  | 'menu'
  | 'leaf'
  | 'search'
  | 'callback'
  | 'external';

interface Props {
  name: IconName | UiIcon;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, strokeWidth = 1.5, class: className, label } = Astro.props;

const PATHS: Record<IconName | UiIcon, string> = {
  // ── Services ──
  garden:
    '<circle cx="12" cy="8.5" r="5"/><path d="M12 13.5V21"/><path d="M9.5 16.5 12 18"/><path d="M3 21h18"/>',
  fence:
    '<path d="M5 20V7.5L6.75 5 8.5 7.5V20"/><path d="M10.25 20V7.5L12 5l1.75 2.5V20"/><path d="M15.5 20V7.5L17.25 5 19 7.5V20"/><path d="M3 10.5h18M3 16h18"/>',
  wall: '<rect x="3" y="6" width="18" height="14" rx="1"/><path d="M3 10.7h18M3 15.3h18M9 6v4.7M15 6v4.7M6 10.7v4.6M12 10.7v4.6M18 10.7v4.6M9 15.3V20M15 15.3V20"/>',
  paving:
