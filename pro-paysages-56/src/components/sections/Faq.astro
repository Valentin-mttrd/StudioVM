---
/**
 * FAQ: native <details> (keyboard and screen readers for free), answers
 * built only from the current site's facts (src/data/site.ts). The page
 * adds the matching FAQPage structured data.
 */
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';

interface Props {
  items: readonly { id: string; q: string; a: string }[];
  index?: string;
}

const { items, index } = Astro.props;
---
<section class="faq section" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <header class="faq__head">
      <p class="label kicker" data-reveal>{index && <span>{index}</span>} Questions fréquentes</p>
      <h2 class="h2" id="faq-title" data-reveal style="--i:1">Vos questions, <em>nos réponses.</em></h2>
      <p class="muted faq__more" data-reveal style="--i:2">
        Une autre question&nbsp;? Appelez-nous au <a href={SITE.phone.href}>{SITE.phone.display}</a> ou{' '}
        <a href="/contact/">écrivez-nous</a>.
      </p>
    </header>

    <div class="faq__list">
      {
        items.map((item, i) => (
          <details class="faq__item" data-reveal style={`--i:${i}`} id={`faq-${item.id}`}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--s-10);
  }

  @media (min-width: 64rem) {
    .faq__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-16);
    }

    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + var(--s-8));
      align-self: start;
    }
  }

  .faq__head {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .faq__more {
    max-width: 36ch;
  }

  .faq__more a {
    font-weight: 650;
    color: var(--c-text);
  }

  .faq__list {
    border-top: 1px solid var(--c-line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line-strong);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    min-height: 4.5rem;
    padding: var(--s-5) 0;
    font-family: var(--f-display);
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    font-weight: 440;
    line-height: 1.3;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 50%;
    transition:
      transform var(--dur-3) var(--ease-out),
      background-color var(--dur-2) ease,
      color var(--dur-2) ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--c-pine);
    border-color: var(--c-pine);
    color: var(--c-on-ink);
  }

  @media (hover: hover) {
    .faq__q:hover .faq__icon {
      border-color: var(--c-ink);
    }
  }

  .faq__q:focus-visible {
    outline-offset: 4px;
  }

  .faq__a {
    max-width: 62ch;
    padding: 0 var(--s-12) var(--s-6) 0;
    color: var(--c-muted);
  }

  /* Smooth opening where the browser can animate to auto height. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size var(--dur-3) var(--ease-out),
        content-visibility var(--dur-3) allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }
</style>
