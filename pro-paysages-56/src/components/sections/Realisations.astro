---
/**
 * Real projects first. While src/data/realisations.ts is empty, the grid
 * keeps its final layout with clearly labelled photo frames, so the page
 * shows where the photos go without ever inventing a project.
 */
import Gallery from '../realisations/Gallery.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import SectionHead from '../ui/SectionHead.astro';
import { REALISATIONS } from '../../data/realisations';
import type { ServiceGroup } from '../../data/site';

interface Props {
  group?: ServiceGroup;
  index?: string;
  title?: string;
}

const { group, index, title = 'Nos jardins en images' } = Astro.props;
const has = REALISATIONS.some((r) => !group || r.group === group);

const SLOTS: Record<'all' | ServiceGroup, string[]> = {
  all: ['Jardin créé, vue d’ensemble', 'Pose de clôture', 'Massif planté', 'Dallage ou pavage', 'Haie taillée'],
  creation: ['Jardin créé, vue d’ensemble', 'Pose de clôture', 'Maçonnerie paysagère', 'Massif planté', 'Engazonnement'],
  entretien: ['Haie avant / après taille', 'Pelouse tondue', 'Massif entretenu', 'Talus débroussaillé', 'Bordures découpées'],
};
const slots = SLOTS[group ?? 'all'];
---
<section class="reals section bg-paper-2" id="realisations" aria-labelledby="reals-title">
  <div class="container">
    <SectionHead kicker="Réalisations" index={index} id="reals-title" align="split">
      {title}
      <Fragment slot="intro">
        {
          has
            ? 'Quelques chantiers de PRO PAYSAGES, de la création à l’entretien.'
            : 'Les photos des chantiers de PRO PAYSAGES prendront place ici : vues d’ensemble, détails et avant / après.'
        }
      </Fragment>
    </SectionHead>

    {
      has ? (
        <Gallery group={group} />
      ) : (
        <ul role="list" class="reals__mosaic">
          {slots.map((label, i) => (
            <li class:list={['reals__slot', `reals__slot--${i}`]} data-reveal="grow" style={`--i:${i}`}>
              <PhotoSlot label={label} ratio={i === 0 ? '4 / 3' : i === 3 ? '3 / 4' : '4 / 3'} class="reals__frame" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .reals__mosaic {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reals__slot--0 {
    grid-column: 1 / -1;
  }

  .reals__slot :global(.reals__frame) {
    height: 100%;
  }

  @media (min-width: 60rem) {
    .reals__mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(2, clamp(12rem, 17vw, 16.5rem));
      gap: var(--s-5);
    }

    .reals__slot :global(.reals__frame) {
      aspect-ratio: auto !important;
    }

    .reals__slot--0 {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }

    .reals__slot--3 {
      grid-column: 3;
      grid-row: 2;
    }
  }
</style>
