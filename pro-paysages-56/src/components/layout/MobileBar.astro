---
/**
 * Thumb-reach action bar on phones: call, or ask for the free quote.
 * Slides away while a form field has focus (it would cover the keyboard
 * and the buttons) and while the menu panel is open.
 */
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';

// On the contact page, jump straight to the form.
const quoteHref = Astro.url.pathname === '/contact/' ? '#devis' : '/contact/';
---
<nav class="mbar" aria-label="Actions rapides" data-mobilebar>
  <a class="mbar__btn mbar__btn--call" href={SITE.phone.href}>
    <Icon name="phone" size={19} />
    <span>Appeler</span>
  </a>
  <a class="mbar__btn mbar__btn--quote" href={quoteHref}>
    <Icon name="leaf" size={19} />
    <span>Devis gratuit</span>
  </a>
</nav>

<style>
  :global(:root) {
    --mobilebar-h: calc(4.25rem + env(safe-area-inset-bottom));
  }

  .mbar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3) calc(var(--s-2) + env(safe-area-inset-bottom));
    background: rgb(244 241 232 / 0.9);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 -1px 0 var(--c-line);
    transition: transform var(--dur-3) var(--ease-out);
  }

  :global(html.menu-open) .mbar,
  :global(html.form-focus) .mbar {
    transform: translateY(110%);
  }

  .mbar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 3.25rem;
    border-radius: var(--r-pill);
    font-weight: 650;
    font-size: var(--fs-sm);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .mbar__btn:active {
    transform: scale(0.97);
  }

  .mbar__btn--call {
    border: 1px solid var(--c-line-strong);
    color: var(--c-ink);
  }

  .mbar__btn--quote {
    background: var(--c-pine);
    color: var(--c-on-ink);
  }

  @media (min-width: 48rem) {
    .mbar {
      display: none;
    }

    :global(:root) {
      --mobilebar-h: 0px;
    }
  }
</style>
