---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { SITE } from '../data/site';
import { absoluteUrl, pageTitle, restaurantSchema, websiteSchema } from '../lib/seo';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  noindex?: boolean;
  /** Header starts transparent over a dark hero (home) or solid (other pages). */
  headerTheme?: 'dark' | 'light';
  ogImage?: string;
}

const {
  title,
  description,
  isHome = false,
  noindex = false,
  headerTheme = 'light',
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'));
const fullTitle = pageTitle(title, isHome);
const schemas = isHome ? [restaurantSchema(), websiteSchema()] : [restaurantSchema()];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Reveal animations hide content until it scrolls into view; if the
      // module script never confirms (.reveal-ready), show everything.
      (function (d) {
        d.classList.add('js-reveal');
        setTimeout(function () {
          if (!d.classList.contains('reveal-ready')) d.classList.remove('js-reveal');
        }, 3000);
      })(document.documentElement);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a3429" />
    <meta name="format-detection" content="telephone=no" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chez Pipon — restaurant, cuisine maison à Lorient" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="FR-56" />
    <meta name="geo.placename" content="Lorient" />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class:list={[isHome && 'is-home']}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header theme={headerTheme} />
    <main id="contenu" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script src="../scripts/main.ts"></script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--color-laiton);
    color: var(--color-vert-950);
    font-weight: 600;
    text-decoration: none;
    translate: 0 -200%;
    transition: translate var(--duration-base) var(--ease-out);
  }
  .skip-link:focus { translate: 0 0; }
</style>
