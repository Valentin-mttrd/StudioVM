---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { PHOTO_SLOTS, photoFor, type PhotoSlot } from '../data/photos';

/**
 * A photo of the real place — or, until one is supplied, a placeholder
 * that says plainly which photo belongs here (see data/photos.ts).
 */
interface Props {
  slot: PhotoSlot;
  /** Alt text for the real photo; defaults to the slot description. */
  alt?: string;
  /** CSS aspect-ratio, e.g. "4 / 5". */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  tone?: 'light' | 'dark';
  priority?: boolean;
  class?: string;
  reveal?: boolean;
}

const {
  slot,
  alt,
  ratio = '4 / 5',
  sizes = '(min-width: 1024px) 40vw, 100vw',
  widths = [480, 760, 1080, 1440],
  tone = 'light',
  priority = false,
  class: className,
  reveal = true,
} = Astro.props;

const src = photoFor(slot);
const description = PHOTO_SLOTS[slot];
---
<figure
  class:list={['photo', `photo--${tone}`, className]}
  style={`aspect-ratio: ${ratio}`}
  data-reveal={reveal ? 'shutter' : undefined}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt ?? description}
        widths={widths.filter((w) => w <= src.width)}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        class="photo__img"
      />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={`Emplacement réservé à une photo : ${description}`}>
        <span class="photo__tag">Photo à venir</span>
        <Icon name="camera" class="photo__icon" stroke={1.2} />
        <span class="photo__caption">{description}</span>
        <span class="photo__credit">@chezpipon</span>
      </div>
    )
  }
</figure>

<style>
  .photo {
    position: relative;
    container-type: inline-size;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-pane);
    background: var(--color-creme-200);
  }
  .photo--dark { background: var(--color-vert-900); }

  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder: a drafting-paper frame, not a fake picture. */
  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.9rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--color-encre-soft);
    background:
      repeating-linear-gradient(135deg, transparent 0 11px, rgb(27 29 26 / 0.045) 11px 12px),
      var(--color-creme-200);
  }
  .photo__placeholder::before {
    content: "";
    position: absolute;
    inset: 0.75rem;
    border: 1px dashed rgb(27 29 26 / 0.25);
    border-radius: 2px;
    pointer-events: none;
  }
  .photo--dark .photo__placeholder {
    color: var(--color-craie-soft);
    background:
      repeating-linear-gradient(135deg, transparent 0 11px, rgb(236 232 222 / 0.05) 11px 12px),
      var(--color-vert-900);
  }
  .photo--dark .photo__placeholder::before { border-color: rgb(236 232 222 / 0.22); }

  .photo__tag {
    position: absolute;
    top: 1.35rem;
    left: 1.35rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .photo__placeholder :global(.photo__icon) { width: 2rem; height: 2rem; opacity: 0.55; }
  .photo__caption {
    max-width: 22ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  /* Small tiles keep only the essentials. */
  @container (max-width: 15rem) {
    .photo__placeholder { gap: 0.5rem; padding: 1rem; }
    .photo__placeholder :global(.photo__icon),
    .photo__credit { display: none; }
    .photo__caption { font-size: 0.92rem; }
    .photo__tag { top: 1.05rem; left: 1.05rem; font-size: 0.6rem; }
  }
  .photo__credit {
    position: absolute;
    right: 1.35rem;
    bottom: 1.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }
</style>
