---
import Icon from '../components/Icon.astro';
import { AWARDS, ELSEWHERE, REVIEW_SUMMARY } from '../data/site';

/**
 * Credibility, early in the visit's second half. Awards and press are
 * shown as they were published; the review is summarised (not quoted)
 * until its exact wording is checked — see data/site.ts.
 */
---
<section id="distinctions" class="dist on-dark section-y" aria-labelledby="dist-title">
  <div class="container-page">
    <header class="dist__head">
      <p class="eyebrow text-laiton" data-reveal>Distinctions</p>
      <h2 id="dist-title" class="dist__title" data-reveal>
        Six mois après l’ouverture, <em>le Gault&amp;Millau s’arrête Chez Pipon.</em>
      </h2>
    </header>

    <ul class="plaques">
      {
        AWARDS.map((award, i) => (
          <li class="plaque" data-reveal data-reveal-group="plaques">
            <span class="plaque__source">{award.source}</span>
            <span class="plaque__title">{award.title}</span>
            <span class="plaque__detail">{award.detail}</span>
            <span class="plaque__corner" aria-hidden="true">{i === 0 ? 'I' : 'II'}</span>
          </li>
        ))
      }
    </ul>

    <div class="dist__cols">
      <section class="review" aria-labelledby="review-title">
        <h3 id="review-title" class="dist__subtitle" data-reveal>Ce que relève le guide</h3>
        <ul class="review__points">
          {
            REVIEW_SUMMARY.points.map((point) => (
              <li data-reveal data-reveal-group="review">
                {point}
              </li>
            ))
          }
        </ul>
        <a class="tlink text-laiton-soft" href={REVIEW_SUMMARY.url} target="_blank" rel="noopener" data-reveal>
          Lire la fiche {REVIEW_SUMMARY.source}
          <Icon name="external" class="tlink__arrow" /><span class="sr-only"> (nouvel onglet)</span>
        </a>
      </section>

      <section aria-labelledby="elsewhere-title">
        <h3 id="elsewhere-title" class="dist__subtitle" data-reveal>Ailleurs sur le web</h3>
        <ul class="elsewhere">
          {
            ELSEWHERE.filter((e) => e.label !== 'Gault&Millau').map((e) => (
              <li data-reveal data-reveal-group="elsewhere">
                <a class="elsewhere__link" href={e.url} target="_blank" rel="noopener">
                  <span class="elsewhere__label">{e.label}</span>
                  <span class="elsewhere__detail">{e.detail}</span>
                  <Icon name="external" class="elsewhere__icon" />
                  <span class="sr-only"> (nouvel onglet)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .dist__cols > * { min-width: 0; }
  .dist {
    position: relative;
    z-index: 1;
    background:
      radial-gradient(70% 60% at 10% 0%, rgb(45 88 69 / 0.5), transparent 70%),
      var(--color-vert-900);
    color: var(--color-craie);
  }

  .dist__title {
    max-width: 20ch;
    margin: 1.25rem 0 0;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    letter-spacing: var(--text-display-lg--letter-spacing);
    font-weight: 380;
    color: var(--color-creme);
  }
  .dist__title em { font-style: italic; font-weight: 330; color: var(--color-laiton-soft); }

  .plaques {
    display: grid;
    gap: 1.25rem;
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  /* Engraved brass plaques */
  .plaque {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    border-radius: 4px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.06), transparent 40%),
      rgb(15 31 24 / 0.55);
    box-shadow:
      inset 0 0 0 1px rgb(207 171 105 / 0.5),
      inset 0 0 0 6px rgb(15 31 24 / 0.55),
      inset 0 0 0 7px rgb(207 171 105 / 0.22);
    overflow: hidden;
  }
  .plaque__source {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-laiton);
  }
  .plaque__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-creme);
  }
  .plaque__detail { color: var(--color-craie-soft); max-width: 36ch; }
  .plaque__corner {
    position: absolute;
    right: 1.5rem;
    top: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 4.5rem;
    line-height: 1;
    color: rgb(207 171 105 / 0.12);
  }

  .dist__cols {
    display: grid;
    gap: 3.5rem;
    margin-top: clamp(3.5rem, 2rem + 4vw, 6rem);
  }
  .dist__subtitle {
    margin: 0 0 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-laiton);
  }

  .review__points {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }
  .review__points li {
    position: relative;
    padding-left: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.05rem + 0.45vw, 1.4rem);
    line-height: 1.4;
    color: var(--color-creme);
  }
  .review__points li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-laiton);
  }

  .elsewhere {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(236 232 222 / 0.14);
  }
  .elsewhere__link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.15rem 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid rgb(236 232 222 / 0.14);
    color: inherit;
    text-decoration: none;
    transition: padding var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out);
  }
  .elsewhere__label {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--color-creme);
  }
  .elsewhere__detail { grid-column: 1; font-size: 0.9rem; color: var(--color-craie-soft); }
  .elsewhere__link :global(.elsewhere__icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-laiton);
    transition: translate var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) {
    .elsewhere__link:hover { padding-left: 0.6rem; }
    .elsewhere__link:hover :global(.elsewhere__icon) { translate: 2px -2px; }
  }

  @media (min-width: 768px) {
    .plaques { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .dist__cols { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 5rem; }
  }
</style>
