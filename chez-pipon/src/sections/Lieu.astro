---
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import { ADDRESS, CONTACT, STORY } from '../data/site';

/**
 * The place. Gault&Millau: corner restaurant, brasserie airs, large green
 * glazed shopfront, casual and bright. Tourist office: warm and friendly,
 * ideal for a quick lunch, a business lunch or a meal with friends.
 */
const facts = [
  { term: 'L’adresse', desc: `${ADDRESS.situation}, au 9.` },
  { term: 'Le décor', desc: 'Un restaurant d’angle aux airs de brasserie, derrière une large devanture verte et vitrée.' },
  { term: 'L’ambiance', desc: 'Lumineuse, décontractée, chaleureuse.' },
  { term: 'La salle', desc: `${STORY.covers} couverts par service.` },
  { term: 'On y vient', desc: 'Pour une pause rapide, un déjeuner professionnel ou un repas entre amis.' },
];
---
<section id="lieu" class="lieu grain section-y" aria-labelledby="lieu-title">
  <div class="container-page">
    <div class="lieu__head">
      <div>
        <p class="eyebrow text-vert-700" data-reveal>Le lieu</p>
        <h2 id="lieu-title" class="lieu__title" data-reveal>
          Un restaurant d’angle <em>aux airs de brasserie.</em>
        </h2>
      </div>
      <dl class="lieu__facts">
        {
          facts.map((f) => (
            <div class="lieu__fact" data-reveal data-reveal-group="facts">
              <dt>{f.term}</dt>
              <dd>{f.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mosaic">
      <div class="mosaic__strip" role="group" aria-label="Photos du restaurant" data-scroller>
        <Photo slot="devanture" ratio="16 / 10" class="mosaic__a" sizes="(min-width: 1024px) 58vw, 82vw" />
        <Photo slot="salle" ratio="4 / 5" class="mosaic__b" sizes="(min-width: 1024px) 34vw, 82vw" />
        <Photo slot="cuisine" ratio="1 / 1" class="mosaic__c" sizes="(min-width: 1024px) 22vw, 82vw" />
        <Photo slot="detail" ratio="1 / 1" class="mosaic__d" sizes="(min-width: 1024px) 18vw, 82vw" />
      </div>
      <p class="mosaic__hint" aria-hidden="true">Faites glisser pour voir les photos →</p>
      <div class="mosaic__cta" data-reveal>
        <p class="mosaic__cta-text">
          L’ardoise du jour, les arrivages, la vie de la salle : tout passe d’abord sur Instagram.
        </p>
        <Button href={CONTACT.instagramUrl} variant="primary" icon="instagram" arrow="external">
          Suivre @{CONTACT.instagramHandle}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .lieu {
    position: relative;
    z-index: 1;
    background: var(--color-creme);
  }

  .lieu__head {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .lieu__title {
    margin: 1.25rem 0 0;
    max-width: 13ch;
    font-size: var(--text-display-xl);
    line-height: var(--text-display-xl--line-height);
    letter-spacing: var(--text-display-xl--letter-spacing);
    font-weight: 380;
  }
  .lieu__title em { font-style: italic; font-weight: 330; color: var(--color-vert-700); }

  .lieu__facts {
    margin: 0;
    border-top: 1px solid rgb(27 29 26 / 0.16);
  }
  .lieu__fact {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid rgb(27 29 26 / 0.16);
  }
  .lieu__fact dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-encre-mute);
    padding-top: 0.2rem;
  }
  .lieu__fact dd { margin: 0; }

  /* Phones: a swipeable strip, each picture nearly full width. */
  .mosaic {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .mosaic__strip {
    display: flex;
    gap: 0.75rem;
    width: calc(100% + 2 * var(--gutter));
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .mosaic__strip::-webkit-scrollbar { display: none; }
  .mosaic__strip > :global(*) {
    flex: 0 0 82%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 5 !important;
  }
  .mosaic__hint {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-encre-mute);
  }

  .mosaic__cta {
    grid-column: 1 / -1;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0;
  }
  .mosaic__cta-text {
    max-width: 26ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .mosaic { display: block; }
    .mosaic__strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
      width: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .mosaic__strip > :global(*) { aspect-ratio: auto; }
    .mosaic__strip > :global(.mosaic__a) { grid-column: 1 / -1; aspect-ratio: 16 / 10 !important; }
    .mosaic__strip > :global(.mosaic__b),
    .mosaic__strip > :global(.mosaic__c),
    .mosaic__strip > :global(.mosaic__d) { aspect-ratio: 3 / 4 !important; }
    .mosaic__hint { display: none; }
  }

  @media (min-width: 1024px) {
    .lieu__head { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: end; }
    .mosaic {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      align-items: start;
    }
    .mosaic__strip { display: contents; }
    .mosaic__strip > :global(.mosaic__c),
    .mosaic__strip > :global(.mosaic__d) { aspect-ratio: 1 / 1 !important; }
    .mosaic :global(.mosaic__a) { grid-column: 1 / span 7; grid-row: 1; }
    .mosaic :global(.mosaic__b) { grid-column: 8 / span 5; grid-row: 1 / span 2; margin-top: 18%; }
    .mosaic :global(.mosaic__c) { grid-column: 1 / span 3; grid-row: 2; }
    .mosaic :global(.mosaic__d) { grid-column: 4 / span 4; grid-row: 2; width: 75%; }
    .mosaic__cta { grid-column: 1 / span 7; grid-row: 3; padding-top: 1rem; }
  }
</style>
